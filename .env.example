# ============================================================
# Variables de Entorno — U.V.A Plataforma v2
#
# Copia este archivo como .env.local y completa cada valor.
# Nunca commitear .env.local ni ningún archivo .env con secretos reales
# (.gitignore ya bloquea .env* excepto este .env.example).
# ============================================================

# --- Base de Datos y Auth (Supabase) ---
#
# NEXT_PUBLIC_SUPABASE_URL
#   Dónde: Supabase Dashboard → Settings → API (o Settings → General)
#   Formato: https://[tu-proyecto].supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# NEXT_PUBLIC_SUPABASE_ANON_KEY
#   Dónde: Supabase Dashboard → Settings → API → "Publishable key" (default)
#   Comienza con: sb_publish_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY
#   ⚠️  SECRETO — nunca lo expongas al cliente ni a git
#   Dónde: Supabase Dashboard → Settings → API → "Secret keys" (default)
#   Comienza con: sb_secret_...
#   Uso: Solo en Server Actions y Route Handlers de webhooks
SUPABASE_SERVICE_ROLE_KEY=

# DATABASE_URL
#   Dónde: Supabase Dashboard → Settings → Infrastructure → Database
#   Copia la "Connection string" del Session Pooler (puerto 5432).
#   El Direct Connection solo resuelve por IPv6 (falla en redes IPv4) y el
#   Transaction Pooler (puerto 6543) no soporta bien las migraciones de
#   Prisma — usa siempre Session Pooler para DATABASE_URL.
#   Formato: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Pasarelas de Pago (Stripe) ---
# Usa claves de test mientras estés en desarrollo.
# Reemplaza por claves de producción cuando hagas deploy.
#
# STRIPE_SECRET_KEY
#   Dónde: Stripe Dashboard → Developers → API keys
#   Comienza con: sk_test_... (desarrollo) o sk_live_... (producción)
STRIPE_SECRET_KEY=

# STRIPE_WEBHOOK_SECRET
#   Dónde: Stripe Dashboard → Developers → Webhooks
#   (Creas un webhook que apunte a https://[tu-dominio]/api/webhooks/stripe)
#   Comienza con: whsec_...
STRIPE_WEBHOOK_SECRET=

# --- Pasarelas de Pago (Wompi — Colombia) ---
#
# WOMPI_PRV_KEY
#   Dónde: Dashboard de Wompi → Configuración → Credenciales
#   (Solo si planeas aceptar pagos en COP desde Colombia)
WOMPI_PRV_KEY=

# --- Mux (Video Streaming) ---
#
# MUX_TOKEN_ID
#   Dónde: Mux Dashboard → Settings → API Access Tokens
MUX_TOKEN_ID=

# MUX_TOKEN_SECRET
#   Dónde: Mux Dashboard → Settings → API Access Tokens
MUX_TOKEN_SECRET=

# MUX_WEBHOOK_SECRET
#   Dónde: Mux Dashboard → Webhooks
#   (Creas un webhook para notificaciones de video procesado)
MUX_WEBHOOK_SECRET=

# MUX_SIGNING_KEY
#   Dónde: Mux Dashboard → Settings → Signing Keys
#   Usado para firmar URLs de reproducción (seguridad)
MUX_SIGNING_KEY=

# --- Correo Transaccional (Resend) ---
#
# RESEND_API_KEY
#   Dónde: Resend Dashboard → API Keys
#   Comienza con: re_...
#   Uso: Envío de emails de bienvenida, recuperación de contraseña, etc.
RESEND_API_KEY=

# RESEND_FROM_EMAIL
#   Dirección remitente verificada en Resend (dominio propio, no @gmail).
#   Formato: "U.V.A <noreply@tudominio.com>"
RESEND_FROM_EMAIL=

# RESEND_TEST_EMAIL
#   Solo para desarrollo — usado por src/app/api/test-email/route.ts.
#   Debe ser el mismo correo con el que te registraste en Resend (modo
#   sandbox solo permite enviar a esa dirección sin dominio verificado).
RESEND_TEST_EMAIL=

# SEND_EMAIL_HOOK_SECRET
#   Dónde: Supabase Dashboard → Authentication → Hooks → Send Email → tipo
#   "HTTPS" → apunta a <origin>/api/webhooks/supabase-auth y copia el
#   secreto que genera (formato v1,whsec_...).
#   Uso: verificar la firma del webhook antes de enviar el correo.
SEND_EMAIL_HOOK_SECRET=
