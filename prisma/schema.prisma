// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums — ver docs/technical-spec.md sección 4 (Diccionario de Datos)
// ============================================================

enum RolPerfil {
  ESTUDIANTE
  ADMINISTRADOR
  /// Cuenta real con login, distinta de `Instructores` (que es solo
  /// catálogo, sin cuenta — ver el comentario en ese modelo). Un perfil
  /// PROFESOR puede vincularse a una fila de `Instructores`
  /// (`Instructores.id_perfil_profesor`) para que sus comentarios en el
  /// reproductor muestren el check de verificado.
  PROFESOR
}

enum EstadoPerfil {
  ACTIVO
  SUSPENDIDO
}

enum EstadoSuscripcion {
  ACTIVA
  PAST_DUE
  VENCIDA
  CANCELADA
}

/// Categorías fijas del feed de Comunidad (F1 del plan — ver conversación de
/// diseño). ANUNCIOS solo la usa un ADMINISTRADOR al crear el post — la
/// restricción vive en la policy de INSERT (supabase/sql/083), no aquí.
enum CategoriaComunidad {
  ANUNCIOS
  PROYECTOS
  PREGUNTAS
  EMPLEO
}

/// REEMBOLSADO y REVERSADO existen desde el diseño, aunque hoy ninguna
/// pasarela esté conectada: sin ellos, registrar una devolución obligaría a
/// mutar la fila del pago original y destruir el rastro contable. El
/// Estatuto del Consumidor colombiano da derecho de retracto en ventas a
/// distancia, y `ref_factura_dian` ya anticipa la factura electrónica —
/// cuya contraparte de una devolución es la nota crédito.
///
/// REEMBOLSADO: devolvimos el dinero al estudiante.
/// REVERSADO:   la pasarela o el banco anularon la transacción (contracargo),
///              sin que mediara una devolución nuestra.
enum EstadoPago {
  EXITOSO
  FALLIDO
  PENDIENTE
  REEMBOLSADO
  REVERSADO
}

enum EstadoProcesamientoLeccion {
  SUBIENDO
  PROCESANDO
  LISTO
  ERROR
}

enum TipoDescuento {
  PORCENTAJE
  MONTO_FIJO
}

/// Nivel de dificultad del curso, usado en filtros del catálogo y del
/// panel admin (ver prompt-panel-admin-claude-code.md). No estaba en el
/// diccionario de datos original de docs/technical-spec.md; se agrega
/// aquí como campo del CMS.
enum NivelCurso {
  BASICO
  INTERMEDIO
  AVANZADO
}

/// MEMBRESIA: alta automática al entrar por primera vez a un curso con
/// Suscripción activa (no es una compra separada). CORTESIA: acceso manual
/// otorgado por un Administrador a un estudiante específico, con fecha de
/// expiración obligatoria (ver docs/functional-spec.md Flujo 11).
enum TipoAcceso {
  MEMBRESIA
  CORTESIA
}

/// Tipo de pregunta de un examen final (ver docs/functional-spec.md Flujo 14).
///
/// El enum enumera los SIETE tipos del diseño, pero la v1 solo implementa los
/// cuatro "cerrados" (autocalificables sin intervención humana):
/// OPCION_UNICA, OPCION_MULTIPLE, VERDADERO_FALSO y RELLENAR_ESPACIO.
///
/// ORDENAR_PASOS, EMPAREJAR y RESPUESTA_ABIERTA quedan declarados desde ya, a
/// propósito: agregar un valor a un enum de Postgres en caliente obliga a un
/// `ALTER TYPE ... ADD VALUE`, que no corre dentro del mismo bloque
/// transaccional que lo usa. Declararlos ahora hace que la Fase 2
/// (docs/development-plan.md, "Exámenes — Fase 2") sea solo UI y calificación,
/// sin migración de tipo. `esTipoImplementado()` (src/lib/examenes/tipos.ts)
/// es el único punto que decide cuáles acepta la app hoy.
enum TipoPregunta {
  OPCION_UNICA
  OPCION_MULTIPLE
  VERDADERO_FALSO
  RELLENAR_ESPACIO
  ORDENAR_PASOS
  EMPAREJAR
  RESPUESTA_ABIERTA
}

/// Estado de un `TrabajosGeneracionExamen`.
///
/// No hay valor "EN_CURSO" aparte: PENDIENTE ya significa "reclamado y sin
/// terminar". La fila se inserta ANTES de llamar al modelo, y el índice
/// parcial único `trabajos_generacion_examen_uno_pendiente` (un solo
/// PENDIENTE por curso) es lo que impide que dos administradores que pulsan
/// el botón a la vez disparen dos generaciones — misma técnica que
/// `intentos_examen_uno_en_curso`. Un tercer estado solo agregaría una
/// transición que nadie observa.
enum EstadoTrabajoGeneracionExamen {
  PENDIENTE
  COMPLETADO
  FALLIDO
}

/// EN_CURSO: el estudiante lo abrió y todavía no lo envió (o se le venció el
/// tiempo sin enviar — lo cierra el propio envío, ver `enviarIntento`).
/// APROBADO/REPROBADO: ya calificado contra `Examenes.nota_aprobatoria`.
/// EN_REVISION: enviado, pero con preguntas de tipo RESPUESTA_ABIERTA que un
/// administrador todavía no calificó a mano. No se produce en la v1 (que solo
/// admite tipos cerrados); existe para la Fase 2, mismo motivo que los valores
/// no implementados de `TipoPregunta`.
enum EstadoIntentoExamen {
  EN_CURSO
  APROBADO
  REPROBADO
  EN_REVISION
}

// ============================================================
// Módulo de Usuarios y Membresía
// ============================================================

/// La contraseña y el proveedor de login viven en auth.users de Supabase.
/// `id` se sincroniza vía trigger de Postgres (ver docs/technical-spec.md §6),
/// no como Foreign Key real de Prisma hacia el esquema `auth`.
model Perfiles {
  id             String       @id @db.Uuid
  nombre         String
  correo         String       @unique
  celular        String?
  /// URL pública del bucket `avatares` (091_perfiles_foto.sql), o `null` si
  /// el usuario nunca subió una — la UI cae en las iniciales sobre un
  /// círculo de color (mismo componente Avatar de siempre). Normalizada a
  /// cuadrada por el servidor antes de subir (ver src/lib/perfil/foto.ts),
  /// así que cualquier imagen de origen se ve bien recortada dentro del
  /// círculo sin depender de que el usuario la recorte a mano.
  foto_url       String?
  /// Derivado del selector de indicativo telefónico en "Mi perfil"
  /// (src/lib/paises.ts), no un campo libre.
  pais           String?
  rol            RolPerfil    @default(ESTUDIANTE)
  /// Área en la que dicta ("Modelado BIM y coordinación de disciplinas"), lo
  /// que antes vivía en `Instructores.especialidad`. Solo tiene sentido para
  /// cuentas con rol PROFESOR; en el resto queda null. Es el único dato de
  /// esta tabla —junto a `nombre`— que se muestra a visitantes sin sesión, y
  /// nunca leyendo `perfiles` directo: va por la vista
  /// `curso_instructores_publico` (supabase/sql/053_curso_instructores.sql),
  /// porque RLS es por fila y abrir la fila abriría también correo y celular.
  especialidad   String?
  estado         EstadoPerfil @default(ACTIVO)
  /// Sello de supresión bajo Ley 1581 (Habeas Data). No null significa que
  /// `nombre`, `correo`, `celular`, `pais` y `especialidad` ya no son datos
  /// del titular sino marcadores, y que la fila de `auth.users` ya no existe.
  ///
  /// La fila NO se borra: diez tablas referencian `perfiles` con ON DELETE
  /// RESTRICT y varias de ellas —`pagos`, `certificados`,
  /// `bitacora_administrativa`— tienen valor contable o probatorio que
  /// sobrevive legítimamente a la cuenta. Se anonimiza, que es lo que la ley
  /// pide y lo que el esquema permite. Ver
  /// supabase/sql/075_anonimizar_usuario.sql y
  /// AUDIT-2026-09-08-base-de-datos.md (D-4).
  anonimizado_en DateTime?    @db.Timestamptz
  creado_en      DateTime     @default(now()) @db.Timestamptz
  actualizado_en DateTime     @updatedAt @db.Timestamptz

  cursos_creados              Cursos[]                 @relation("CursosCreadosPorAdmin")
  categorias_creadas          Categorias[]             @relation("CategoriasCreadasPorAdmin")
  instructores_creados        Instructores[]           @relation("InstructoresCreadosPorAdmin")
  codigos_invitacion_creados  CodigosInvitacion[]      @relation("CodigosInvitacionCreadosPorAdmin")
  lotes_codigos_creados       LotesCodigosInvitacion[] @relation("LotesCodigosCreadosPorAdmin")
  tokens_vista_previa_creados TokensVistaPrevia[]      @relation("TokensVistaPreviaCreadosPorAdmin")
  suscripciones               Suscripciones[]          @relation("SuscripcionesDelUsuario")
  suscripciones_otorgadas     Suscripciones[]          @relation("SuscripcionesOtorgadasPorAdmin")
  suscripciones_canceladas    Suscripciones[]          @relation("SuscripcionesCanceladasPorAdmin")
  progreso                    Progreso[]
  certificados                Certificados[]
  inscripciones               Inscripciones[]          @relation("InscripcionesDelUsuario")
  inscripciones_otorgadas     Inscripciones[]          @relation("InscripcionesOtorgadasPorAdmin")
  inscripciones_revocadas     Inscripciones[]          @relation("InscripcionesRevocadasPorAdmin")
  acciones_bitacora           BitacoraAdministrativa[]
  instructor_vinculado        Instructores?            @relation("InstructorEsPerfil")
  comentarios                 Comentarios[]
  comentario_likes            ComentarioLikes[]
  comentarios_moderados       ComentarioModeracion[]
  cursos_dictados             CursoInstructores[]      @relation("CursoInstructoresPerfil")
  intentos_examen             IntentosExamen[]
  comunidad_posts             ComunidadPosts[]
  comunidad_respuestas        ComunidadRespuestas[]
  comunidad_reacciones        ComunidadReacciones[]
  comunidad_moderaciones      ComunidadModeracion[]    @relation("ComunidadModeradaPorAdmin")
  configuraciones_comunidad   ConfiguracionComunidad[] @relation("ConfiguracionComunidadActualizadaPorAdmin")
  comunidad_adjuntos          ComunidadAdjuntos[]
  comunidad_reportes          ComunidadReportes[]      @relation("ComunidadReportadaPor")
  notificaciones              Notificaciones[]         @relation("NotificacionesDelUsuario")
  notificaciones_generadas    Notificaciones[]         @relation("NotificacionesGeneradasPorActor")

  @@map("perfiles")
}

/// Catálogo de planes de membresía. `precio_centavos` + `moneda` son el
/// precio de REFERENCIA que muestra el catálogo público; lo que efectivamente
/// se cobra a través de cada pasarela vive en `PlanesPrecios`, porque el mismo
/// plan necesita precio en COP (Wompi) y en USD (Stripe).
///
/// Hoy la tabla se usa sin cobro: `otorgarMembresia` lee `duracion_dias` para
/// calcular hasta cuándo dura un acceso otorgado a mano.
model Planes {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre          String
  descripcion     String?
  /// BigInt, no Int: en centavos de peso colombiano un INTEGER de 4 bytes
  /// tope en $21.474.836, y Postgres no trunca — lanza 22003 y el INSERT
  /// falla. Ver la migración `esquema_listo_para_cobro`.
  precio_centavos BigInt
  /// ISO-4217 en mayúsculas ('COP', 'USD'). Lo garantiza un CHECK en la base
  /// (supabase/sql/042): `formatMoneda` se lo pasa a Intl.NumberFormat, que
  /// lanza RangeError con cualquier otra cosa y tumbaría la pantalla.
  moneda          String
  duracion_dias   Int
  nivel_acceso    String?
  activo          Boolean  @default(true)
  orden           Int      @default(0)
  creado_en       DateTime @default(now()) @db.Timestamptz
  actualizado_en  DateTime @updatedAt @db.Timestamptz

  suscripciones Suscripciones[]
  precios       PlanesPrecios[]

  @@map("planes")
}

/// Precio de un plan EN una pasarela concreta. Tabla vacía a propósito:
/// llenarla es parte de la integración de cobro, que está diferida.
///
/// Resuelve dos cosas de una vez, sin tocar `Planes`:
///   1. El mapeo plan → precio del proveedor. Sin él no hay contra qué
///      conciliar un webhook, que es literalmente lo que dice el TODO de
///      `src/app/api/webhooks/stripe/route.ts`.
///   2. El precio por moneda. `Planes` tiene una sola pareja precio/moneda,
///      pero docs/technical-spec.md define Stripe para facturación
///      internacional y Wompi para Colombia.
///
/// Para enchufar una pasarela se insertan filas aquí y se lee
/// `id_precio_externo` desde el webhook. Ninguna tabla existente cambia.
model PlanesPrecios {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_plan           String   @db.Uuid
  /// Genérico, nunca una columna por pasarela ('id_precio_stripe'). Valores
  /// admitidos acotados por CHECK en supabase/sql/042 y por
  /// `PROVEEDORES_PASARELA` en src/lib/pagos/proveedores.ts.
  proveedor         String
  /// El identificador del lado del proveedor (`price_...` en Stripe): es lo
  /// que llega en el webhook.
  id_precio_externo String
  monto_centavos    BigInt
  moneda            String
  /// Retirar un precio sin borrar la fila: los pagos históricos tienen que
  /// seguir pudiendo explicarse.
  activo            Boolean  @default(true)
  creado_en         DateTime @default(now()) @db.Timestamptz
  actualizado_en    DateTime @updatedAt @db.Timestamptz

  plan Planes @relation(fields: [id_plan], references: [id], onDelete: Restrict)

  @@unique([id_plan, proveedor, moneda])
  @@unique([proveedor, id_precio_externo])
  @@index([id_plan])
  @@map("planes_precios")
}

/// El "permiso de acceso" de la plataforma. Una fila aquí es lo que abre el
/// contenido, venga de donde venga: `proveedor` es lo único que distingue una
/// invitación canjeada de un acceso otorgado a mano o de un cobro por
/// pasarela. Por eso enchufar Stripe no toca el muro de acceso —
/// `tieneAccesoVigente()` (src/lib/mux/acceso.ts) solo mira `estado` y
/// `fecha_renovacion`, nunca el origen.
///
/// Un índice único parcial (`suscripcion_activa_unica_por_usuario`) admite a
/// lo sumo UNA fila en ACTIVA o PAST_DUE por usuario. Consecuencia a tener
/// presente cuando llegue el cobro: no se puede modelar una renovación
/// programada ni un cambio de plan solapado sin cerrar antes la vigente.
model Suscripciones {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_usuario             String            @db.Uuid
  /// Nullable: un acceso otorgado por código de invitación no compró ningún
  /// plan, así que no tiene ninguno que referenciar. Las suscripciones de
  /// pago (Stripe/Wompi) y las que otorga el admin a mano sí lo llenan.
  /// Quien lo lee debe tener un valor por defecto — ver `lib/suscripcion.ts`
  /// y `lib/admin/usuarioDetalle.ts`, que muestran "Acceso por invitación".
  id_plan                String?           @db.Uuid
  /// `@db.Timestamptz` no es decorativo: `private.suscripcion_da_acceso()`
  /// hace `fecha_renovacion AT TIME ZONE 'America/Bogota'`, y esa expresión
  /// significa cosas OPUESTAS según el tipo — sobre `timestamptz` convierte un
  /// instante a hora de pared (lo correcto), sobre un `timestamp` desnudo
  /// interpreta la hora de pared como si fuera de esa zona. Mientras fueron
  /// `timestamp`, toda membresía otorgada después de las 2 p.m. hora de
  /// Colombia vencía un día tarde. Además Stripe envía `current_period_end`
  /// como epoch Unix: un instante absoluto, que sin zona pierde su sentido.
  fecha_inicio           DateTime          @db.Timestamptz
  fecha_renovacion       DateTime?         @db.Timestamptz
  estado                 EstadoSuscripcion
  /// El ORIGEN del acceso, y el único campo que hay que mirar para saber de
  /// dónde salió: 'invitacion' (código canjeado), 'manual' (otorgado por un
  /// admin) y, cuando llegue el cobro, 'stripe' o 'wompi'. Genérico a
  /// propósito, nunca acoplado a una pasarela concreta. Valores admitidos en
  /// src/lib/pagos/proveedores.ts, sellados por CHECK en supabase/sql/042.
  proveedor              String
  id_cliente_externo     String?
  id_suscripcion_externa String?
  /// BigInt por el techo de $21.474.836 COP de un INTEGER en centavos.
  /// NOT NULL, así que las invitaciones escriben 0: un acceso gratuito no
  /// tiene monto, pero la columna no admite ausencia.
  monto_centavos         BigInt
  /// ISO-4217 en mayúsculas, garantizado por CHECK en supabase/sql/042.
  moneda                 String
  id_cupon               String?           @db.Uuid
  id_codigo_invitacion   String?           @db.Uuid
  /// Redundante con `proveedor` a propósito: equivale exactamente a
  /// `proveedor IN ('manual','invitacion')`. Se conserva porque la leen seis
  /// módulos, pero un CHECK (supabase/sql/042) sella la equivalencia para que
  /// las dos columnas no puedan contradecirse.
  acceso_manual          Boolean           @default(false)
  otorgado_por           String?           @db.Uuid
  /// Motivo que el admin escribió al revocar (f4accesos.md: "marca inactivo
  /// con fecha y motivo"). Null mientras la suscripción nunca se canceló a
  /// mano. La fecha es `actualizado_en` — ya se refresca en cada UPDATE, no
  /// hace falta una columna aparte solo para el momento de la revocación.
  motivo_cancelacion     String?
  /// Quién ejecutó la cancelación manual (revocarMembresia). Null si la
  /// suscripción nunca se canceló, o si se cerró sola por vencimiento de
  /// fecha (038_vigencia_por_fecha.sql) en vez de por acción de un admin.
  cancelado_por          String?           @db.Uuid
  creado_en              DateTime          @default(now()) @db.Timestamptz
  actualizado_en         DateTime          @updatedAt @db.Timestamptz

  usuario           Perfiles           @relation("SuscripcionesDelUsuario", fields: [id_usuario], references: [id])
  plan              Planes?            @relation(fields: [id_plan], references: [id])
  cupon             Cupones?           @relation(fields: [id_cupon], references: [id])
  codigo_invitacion CodigosInvitacion? @relation(fields: [id_codigo_invitacion], references: [id])
  admin_otorgo      Perfiles?          @relation("SuscripcionesOtorgadasPorAdmin", fields: [otorgado_por], references: [id])
  admin_cancelo     Perfiles?          @relation("SuscripcionesCanceladasPorAdmin", fields: [cancelado_por], references: [id])
  pagos             Pagos[]

  @@index([id_usuario])
  @@index([id_plan])
  @@index([proveedor, id_suscripcion_externa])
  /// Los eventos `customer.*` de Stripe llegan identificados por el cliente,
  /// no por la suscripción: ese camino de conciliación necesita su índice.
  @@index([id_cliente_externo])
  @@index([id_cupon])
  @@index([id_codigo_invitacion])
  /// P2-3 (AUDIT-2026-09-04.md): "otorgamientos/revocaciones de este
  /// administrador" (bitácora, panel de usuarios) hacía seq scan sin esto.
  @@index([otorgado_por])
  @@index([cancelado_por])
  // Dos índices únicos PARCIALES viven como SQL crudo, no como @@unique
  // (Prisma no soporta WHERE en índices únicos nativos):
  //   - suscripcion_activa_unica_por_usuario (id_usuario) WHERE estado IN
  //     ('ACTIVA','PAST_DUE') -- 20260818142831_suscripcion_activa_unica_y_pgcrypto
  //   - suscripcion_codigo_unica_por_usuario (id_usuario, id_codigo_invitacion)
  //     WHERE id_codigo_invitacion IS NOT NULL --
  //     20260828130000_unico_codigo_por_usuario
  @@map("suscripciones")
}

/// Registro de un cobro. Tabla VACÍA: nada en el código escribe en ella
/// todavía, y llenarla es parte de la integración de cobro, que está diferida.
///
/// La idempotencia está pensada en dos niveles y los dos hacen falta:
///   - AQUÍ, por transacción: `@@unique([proveedor, ref_transaccion_externa])`
///     impide una segunda fila para el mismo cobro.
///   - En `EventosWebhook`, por evento: impide reprocesar la misma entrega.
/// Las dos claves se componen con `proveedor` porque dos pasarelas distintas
/// pueden emitir la misma cadena y nada más las distinguiría.
model Pagos {
  id                      String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_suscripcion          String     @db.Uuid
  /// Cuándo insertamos NOSOTROS la fila. No es la fecha del cobro: ver
  /// `fecha_pago`.
  creado_en               DateTime   @default(now()) @db.Timestamptz
  actualizado_en          DateTime   @updatedAt @db.Timestamptz
  /// Cuándo cobró la PASARELA, según la pasarela. Nullable porque no todas lo
  /// reportan: `getSuscripcionActual` (src/lib/suscripcion.ts) resuelve
  /// `fecha_pago ?? creado_en` y ordena el historial por esa fecha ya
  /// resuelta. Existe porque Stripe reintenta la entrega de un webhook hasta
  /// tres días, y sin esta columna el estudiante vería la fecha del reintento
  /// como la fecha de su pago.
  fecha_pago              DateTime?  @db.Timestamptz
  estado                  EstadoPago
  /// Qué pasarela procesó este cobro. Sin esta columna habría que deducirlo
  /// por join contra `suscripciones`, y la clave de idempotencia de abajo no
  /// se podría componer. Solo pasarelas reales: un acceso manual o por
  /// invitación nunca genera una fila aquí (CHECK en supabase/sql/042).
  proveedor               String
  /// BigInt por el techo de $21.474.836 COP de un INTEGER en centavos.
  monto_centavos          BigInt
  /// ISO-4217 en mayúsculas, garantizado por CHECK en supabase/sql/042.
  moneda                  String
  /// La CLAVE DE IDEMPOTENCIA: el identificador de la transacción del lado del
  /// proveedor. El nombre no lo transmite, por eso este comentario.
  ref_transaccion_externa String
  ref_factura_dian        String?
  url_pdf_factura         String?

  suscripcion Suscripciones @relation(fields: [id_suscripcion], references: [id])

  @@unique([proveedor, ref_transaccion_externa])
  @@index([id_suscripcion])
  @@map("pagos")
}

// ============================================================
// Módulo de Contenido (Catálogo LMS)
// ============================================================

model Categorias {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre           String
  /// Identificador legible para las URLs del catálogo. Lo genera la app
  /// desde `nombre` con slugificar() (src/lib/slug.ts); es único porque dos
  /// categorías no pueden compartir URL.
  slug             String   @unique
  descripcion      String?
  activo           Boolean  @default(true)
  id_admin_creador String?  @db.Uuid
  creado_en        DateTime @default(now()) @db.Timestamptz
  actualizado_en   DateTime @updatedAt @db.Timestamptz

  cursos        CursoCategorias[]
  admin_creador Perfiles?         @relation("CategoriasCreadasPorAdmin", fields: [id_admin_creador], references: [id])

  @@index([id_admin_creador])
  @@map("categorias")
}

/// Enlace temporal para previsualizar un curso en borrador sin tener cuenta
/// (Revcurso, requisito 3). Guarda el SHA-256 del token, nunca el token en
/// claro: un volcado de la base no debe entregar enlaces funcionales a
/// contenido sin publicar.
model TokensVistaPrevia {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token_hash       String    @unique
  id_curso         String    @db.Uuid
  id_admin_creador String?   @db.Uuid
  /// NOT NULL a propósito: no existe el enlace de vista previa permanente.
  expira_en        DateTime  @db.Timestamptz
  /// Corte manual antes de la caducidad, si el enlace se compartió por error.
  revocado_en      DateTime? @db.Timestamptz
  veces_usado      Int       @default(0)
  creado_en        DateTime  @default(now()) @db.Timestamptz
  actualizado_en   DateTime  @updatedAt @db.Timestamptz

  curso         Cursos    @relation(fields: [id_curso], references: [id], onDelete: Cascade)
  admin_creador Perfiles? @relation("TokensVistaPreviaCreadosPorAdmin", fields: [id_admin_creador], references: [id])

  @@index([id_curso])
  /// P2-3 (AUDIT-2026-09-04.md): "tokens de vista previa creados por este
  /// administrador" hacía seq scan sin esto.
  @@index([id_admin_creador])
  @@map("tokens_vista_previa")
}

/// Tabla puente curso↔categoría (muchos-a-muchos). Hoy el CMS solo asigna
/// una categoría por curso (no hay selector múltiple en el formulario),
/// pero el esquema ya soporta varias — ver auditoría de esquema (Bloque 3).
model CursoCategorias {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_curso       String   @db.Uuid
  id_categoria   String   @db.Uuid
  creado_en      DateTime @default(now()) @db.Timestamptz
  actualizado_en DateTime @updatedAt @db.Timestamptz

  curso     Cursos     @relation(fields: [id_curso], references: [id], onDelete: Cascade)
  categoria Categorias @relation(fields: [id_categoria], references: [id], onDelete: Restrict)

  @@unique([id_curso, id_categoria])
  @@index([id_categoria])
  @@map("curso_categorias")
}

/// ⚠️ TABLA VESTIGIAL — NINGUNA CAPA DE LA APLICACIÓN LA LEE NI LA ESCRIBE.
///
/// Instructor y Profesor eran dos entidades (esta tabla, sin cuenta, puenteada
/// opcionalmente a `Perfiles` por `id_perfil_profesor`). Eso fue un error
/// conceptual: son la misma persona. Desde la migración
/// `20260903000000_multi_instructores`, quién dicta un curso vive en
/// `CursoInstructores` (puente muchos-a-muchos hacia `Perfiles` con rol
/// PROFESOR) y la especialidad en `Perfiles.especialidad`.
///
/// Por qué sigue aquí y no se borró en la misma migración: los 3 instructores
/// reales con cursos publicados (Ana Ruiz, Daniel Castaño, Mauricio Gallego)
/// todavía NO tienen cuenta. Y una fila de `Perfiles` solo puede nacer del
/// trigger sobre `auth.users` (supabase/sql/000_trigger_perfiles.sql), así que
/// no hay forma de migrarlos automáticamente: tienen que registrarse en
/// /registro y un admin ascenderlos con "Hacer profesor". Borrar la tabla y la
/// FK `cursos.id_instructor` antes de eso perdería el único registro de quién
/// dicta esos 6 cursos.
///
/// LIMPIEZA PENDIENTE (migración futura, una vez reasignados esos cursos):
/// DROP de `instructores`, de `cursos.id_instructor`, de las policies de
/// `supabase/sql/006_rls_instructores.sql` y del índice
/// `instructores_nombre_trgm_idx` (034). No agregues código nuevo contra ella.
model Instructores {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre             String   @unique
  especialidad       String?
  id_admin_creador   String?  @db.Uuid
  /// Nullable: la mayoría de instructores son solo catálogo, sin cuenta (ver
  /// el comentario de esta tabla más arriba). Cuando SÍ hay una cuenta con
  /// rol PROFESOR detrás de este instructor, este campo la vincula — es lo
  /// que permite mostrar el check de verificado en sus comentarios.
  id_perfil_profesor String?  @unique @db.Uuid
  creado_en          DateTime @default(now()) @db.Timestamptz
  actualizado_en     DateTime @updatedAt @db.Timestamptz

  admin_creador   Perfiles? @relation("InstructoresCreadosPorAdmin", fields: [id_admin_creador], references: [id])
  perfil_profesor Perfiles? @relation("InstructorEsPerfil", fields: [id_perfil_profesor], references: [id])
  cursos          Cursos[]

  /// P2-3 (AUDIT-2026-09-04.md): "instructores creados por este
  /// administrador" hacía seq scan sin esto.
  @@index([id_admin_creador])
  @@map("instructores")
}

model Cursos {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titulo              String
  /// Identificador legible para la URL pública del curso y sus lecciones
  /// (/cursos/render-fotorrealista-con-v-ray en vez de /cursos/<uuid>). Lo
  /// genera la app desde `titulo` con slugificar() (src/lib/slug.ts), mismo
  /// patrón que `Categorias.slug`; único porque dos cursos no pueden
  /// compartir URL. Las rutas públicas siguen aceptando el UUID además del
  /// slug (mismo criterio que `resolverCategoria`, lib/categoria.ts).
  slug                String     @unique
  descripcion         String
  imagen_portada      String
  /// ⚠️ COLUMNA VESTIGIAL — ninguna capa de la aplicación la lee ni la
  /// escribe desde la migración `20260903000000_multi_instructores`. Quién
  /// dicta el curso está en `instructores` (relación `CursoInstructores`),
  /// que además admite varios. Pasó a NULLABLE en esa migración porque
  /// `crearCurso()` ya no la rellena; las filas viejas conservan su valor
  /// como único rastro de a quién pertenecen los 6 cursos reales hasta que
  /// esos instructores tengan cuenta. Ver el comentario del modelo
  /// `Instructores` para la limpieza pendiente.
  id_instructor       String?    @db.Uuid
  nivel               NivelCurso @default(BASICO)
  destacado           Boolean    @default(false)
  orden_visualizacion Int        @default(0)
  mostrado            Boolean    @default(false)
  id_admin_creador    String     @db.Uuid
  creado_en           DateTime   @default(now()) @db.Timestamptz
  actualizado_en      DateTime   @updatedAt @db.Timestamptz

  /// Vestigial junto con `id_instructor` — ver el comentario de esa columna.
  instructor          Instructores?              @relation(fields: [id_instructor], references: [id])
  admin_creador       Perfiles                   @relation("CursosCreadosPorAdmin", fields: [id_admin_creador], references: [id])
  modulos             Modulos[]
  certificados        Certificados[]
  inscripciones       Inscripciones[]
  categorias          CursoCategorias[]
  /// Quién dicta el curso: 1 o más cuentas con rol PROFESOR.
  instructores        CursoInstructores[]
  tokens_vista_previa TokensVistaPrevia[]
  /// Como máximo uno (ver el `@unique` de `Examenes.id_curso`).
  examen              Examenes?
  transcripciones     TranscripcionesVideo[]
  trabajos_generacion TrabajosGeneracionExamen[]

  @@index([id_instructor])
  @@index([id_admin_creador])
  @@map("cursos")
}

/// Tabla puente curso↔profesor (muchos-a-muchos): un curso puede dictarlo más
/// de una persona y una persona puede dictar varios cursos.
///
/// `id_instructor` apunta a `Perfiles`, NO a `Instructores`: instructor y
/// profesor son la misma entidad (una cuenta real con login y rol PROFESOR),
/// no dos tablas puenteadas. Ver el comentario del modelo `Instructores`.
///
/// Solo `nombre` y `especialidad` de esas filas de `Perfiles` son públicos, y
/// se leen por la vista `curso_instructores_publico`
/// (supabase/sql/053_curso_instructores.sql) — nunca consultando `perfiles`
/// directo desde una ruta pública, que expondría correo, celular y estado.
model CursoInstructores {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_curso      String   @db.Uuid
  id_instructor String   @db.Uuid
  creado_en     DateTime @default(now()) @db.Timestamptz

  curso      Cursos   @relation(fields: [id_curso], references: [id], onDelete: Cascade)
  instructor Perfiles @relation("CursoInstructoresPerfil", fields: [id_instructor], references: [id])

  @@unique([id_curso, id_instructor])
  @@index([id_instructor])
  @@map("curso_instructores")
}

model Modulos {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_curso       String   @db.Uuid
  titulo         String
  orden          Int      @default(0)
  creado_en      DateTime @default(now()) @db.Timestamptz
  actualizado_en DateTime @updatedAt @db.Timestamptz

  curso     Cursos      @relation(fields: [id_curso], references: [id], onDelete: Restrict)
  lecciones Lecciones[]

  @@index([id_curso])
  @@map("modulos")
}

model Lecciones {
  id                   String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_modulo            String                     @db.Uuid
  titulo               String
  /// Identificador legible para la URL pública de la lección, único dentro
  /// del curso (no globalmente — dos cursos distintos sí pueden repetir,
  /// p. ej., "introduccion"). Sin índice UNIQUE de Postgres porque esta
  /// tabla no tiene `id_curso` directo (solo vía `modulo.id_curso`); la
  /// unicidad por curso la garantiza la app al generarlo (mismo patrón que
  /// `Cursos.slug`, ver src/lib/slug.ts).
  slug                 String
  orden                Int                        @default(0)
  /// Derivado, NO editable a mano: true solo para la primera lección del
  /// curso por (modulo.orden, leccion.orden), y solo si el curso tiene más
  /// de una. Es la clase gratuita del catálogo.
  ///
  /// Materializa lo que antes calculaba `private.es_leccion_introductoria()`
  /// en cada evaluación de RLS — una función que unía `lecciones` con
  /// `modulos` de todo el curso y ordenaba, POR FILA. Medido: 605 buffers y
  /// 3,5 ms solo por ese predicado sobre 29 comentarios
  /// (AUDIT-2026-09-08-base-de-datos.md, D-3).
  ///
  /// La mantiene `private.recalcular_leccion_introductoria()` vía triggers
  /// sobre `lecciones` y `modulos` — ver
  /// supabase/sql/076_leccion_introductoria_materializada.sql.
  es_introductoria     Boolean                    @default(false)
  /// Playback ID de Mux (docs/technical-spec.md §4) — se escribe recién en
  /// video.asset.ready. No se toca al reemplazar el video hasta que el
  /// nuevo asset esté listo (Flujo 10): el estudiante sigue viendo el
  /// anterior mientras el nuevo procesa.
  id_video_mux         String?
  /// ID del Direct Upload de Mux, guardado al pedirlo (antes de que exista
  /// el asset). Es la única forma de correlacionar el webhook de Mux
  /// (video.asset.ready/errored, video.upload.cancelled) con esta fila.
  id_mux_upload_id     String?                    @unique
  /// ID del asset de Mux una vez creado. Para operaciones futuras sobre el
  /// asset (no se usa para generar la URL firmada, que solo necesita el
  /// playback ID).
  id_mux_asset_id      String?
  duracion             Int?
  estado_procesamiento EstadoProcesamientoLeccion @default(SUBIENDO)
  /// Mensaje de Mux cuando estado_procesamiento = ERROR (video.asset.errored
  /// o video.upload.cancelled). Null en cualquier otro estado.
  error_procesamiento  String?
  /// Legado: resumen en texto plano, reemplazado por `contenido` (editor
  /// enriquecido). Ya no se escribe desde la app — se conserva solo como
  /// respaldo de lecciones sembradas antes de este campo; getCursoDetalle,
  /// getLeccionPlayer y getLeccionVistaPrevia lo usan como valor inicial de
  /// `contenido` (un único párrafo) cuando la lección todavía no tiene JSON
  /// propio, para no perder texto ya publicado.
  resumen              String?
  /// Documento JSON de Tiptap/ProseMirror con el contenido enriquecido de la
  /// lección (texto con formato, listas, citas, bloques de código, etc.).
  /// Fuente de verdad del contenido — nunca se guarda HTML. Validado contra
  /// contenidoLeccionSchema (src/lib/editor/tipos.ts) antes de escribir.
  contenido            Json?
  creado_en            DateTime                   @default(now()) @db.Timestamptz
  actualizado_en       DateTime                   @updatedAt @db.Timestamptz

  modulo              Modulos                          @relation(fields: [id_modulo], references: [id], onDelete: Cascade)
  progreso            Progreso[]
  transcripcion       TranscripcionesVideo?
  preguntas_generadas PreguntasExamen[]
  recursos            RecursosDescargables[]
  assetsMuxPendientes MuxAssetsPendientesEliminacion[]
  comentarios         Comentarios[]

  @@index([id_modulo, orden])
  @@map("lecciones")
}

/// Cola de assets de Mux pendientes de eliminar tras un reemplazo de video
/// (ver comentario en id_video_mux arriba: el asset viejo nunca se borra
/// antes de confirmar que el nuevo quedó listo). Se llena desde el webhook
/// (video.asset.ready) porque es el único punto que ve el id del asset
/// anterior antes de que el UPDATE de `lecciones` lo sobreescriba.
///
/// El borrado real contra la API de Mux (mux.video.assets.delete) todavía
/// no está implementado — depende de tener acceso al dominio de Mux del
/// equipo. `eliminado`/`eliminado_en` quedan listos para cuando exista ese
/// job de limpieza.
model MuxAssetsPendientesEliminacion {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_leccion   String?   @db.Uuid
  id_asset_mux String
  eliminado    Boolean   @default(false)
  eliminado_en DateTime? @db.Timestamptz
  creado_en    DateTime  @default(now()) @db.Timestamptz

  leccion Lecciones? @relation(fields: [id_leccion], references: [id], onDelete: SetNull)

  @@index([eliminado])
  /// P2-3 (AUDIT-2026-09-04.md): mux:verificar-atascados busca por
  /// id_leccion además de eliminado -- hacía seq scan sin esto.
  @@index([id_leccion])
  @@map("mux_assets_pendientes_eliminacion")
}

// ============================================================
// Módulo de Evaluación (exámenes finales)
// ============================================================

/// Examen final de un curso. `@unique` en `id_curso`: un curso tiene como
/// máximo UN examen final (no es una tabla de "cuestionarios por módulo").
///
/// Su ausencia es significativa — la regla de certificación
/// (`private.curso_esta_completo`, supabase/sql/068) exige aprobar examen
/// SOLO si existe uno publicado para el curso. Un curso sin fila acá, o con
/// `publicado = false`, certifica con el 100% de lecciones igual que antes de
/// que existiera este módulo: quien crea el curso decide si su curso necesita
/// examen o no.
model Examenes {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_curso              String   @unique @db.Uuid
  titulo                String
  /// Instrucciones que el estudiante lee antes de iniciar (documento Tiptap,
  /// mismo formato que `Lecciones.contenido`).
  instrucciones         Json?
  /// Porcentaje mínimo para aprobar. El default y el piso duro son 75 (regla
  /// de negocio, docs/functional-spec.md Flujo 14): la restricción
  /// `examenes_nota_aprobatoria_minima` lo impone en la base, no solo en el
  /// formulario — el admin puede exigir MÁS, nunca menos.
  nota_aprobatoria      Int      @default(75)
  /// Intentos permitidos por estudiante. `null` = sin límite.
  intentos_maximos      Int?     @default(3)
  /// Minutos de duración del intento. `null` = sin límite de tiempo. El corte
  /// real se valida contra `IntentosExamen.iniciado_en` en el servidor, nunca
  /// contra el reloj del cliente.
  minutos_limite        Int?
  aleatorizar_preguntas Boolean  @default(true)
  aleatorizar_opciones  Boolean  @default(true)
  /// Mientras es false el examen no existe para el estudiante y no bloquea la
  /// certificación de nadie — así se arma con calma en un curso que ya tiene
  /// estudiantes activos, igual que `Cursos.mostrado`.
  publicado             Boolean  @default(false)
  creado_en             DateTime @default(now()) @db.Timestamptz
  actualizado_en        DateTime @updatedAt @db.Timestamptz

  curso     Cursos            @relation(fields: [id_curso], references: [id], onDelete: Cascade)
  preguntas PreguntasExamen[]
  intentos  IntentosExamen[]

  @@map("examenes")
}

/// Una pregunta del examen. `enunciado` es un documento Tiptap (mismo
/// `contenidoLeccionSchema` que valida `Lecciones.contenido`) para que una
/// pregunta pueda llevar listas, citas o bloques de código — no solo texto
/// plano.
///
/// `opciones` guarda la forma propia de cada tipo, validada en el servidor por
/// el discriminated union de `src/lib/examenes/tipos.ts` antes de escribir:
///   OPCION_UNICA / OPCION_MULTIPLE / VERDADERO_FALSO
///     -> [{ id, texto, correcta }]
///   RELLENAR_ESPACIO
///     -> null; la respuesta vive en `respuestas_aceptadas`
///
/// ⚠️ Esta tabla contiene las respuestas correctas. RLS le abre SELECT solo a
/// administradores (supabase/sql/067): el estudiante NUNCA la lee directo —
/// recibe las preguntas ya despojadas de `correcta`/`respuestas_aceptadas`
/// por `prepararPreguntasParaEstudiante()`.
model PreguntasExamen {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_examen            String       @db.Uuid
  tipo                 TipoPregunta
  enunciado            Json
  /// Peso de la pregunta en el puntaje final. El % del intento es
  /// (puntos obtenidos / puntos posibles) * 100, no un conteo de preguntas.
  puntos               Int          @default(1)
  /// Fraccionado igual que `Modulos.orden` / `Lecciones.orden` — ver
  /// src/lib/orden.ts, mismo drag & drop que el temario.
  orden                Int          @default(0)
  opciones             Json?
  /// Solo RELLENAR_ESPACIO: variantes aceptadas como correctas, ya
  /// normalizadas al guardar (minúsculas, sin tildes, sin espacios de sobra —
  /// `normalizarRespuestaCorta()`). Comparar contra una lista y no contra un
  /// único string es lo que evita reprobar a alguien por escribir "V-Ray" en
  /// vez de "vray".
  respuestas_aceptadas String[]
  /// Feedback pedagógico. NO se le muestra al estudiante en la v1 mientras le
  /// queden intentos (decisión de producto: con 3 intentos, mostrarlo permite
  /// reconstruir el examen completo). Se guarda para la revisión posterior y
  /// para el reporte del admin.
  explicacion          Json?
  /// De cuál video (lección) salió esta pregunta, cuando la generó el
  /// pipeline de IA. `null` = la escribió un administrador a mano.
  ///
  /// El examen sigue siendo del CURSO —eso ya lo fija `Examenes.id_curso`,
  /// que es `@unique`— y esta columna no lo cambia: solo dice de qué parte
  /// del temario se sacó la pregunta, para poder auditar por video cuáles
  /// quedaron bien y cuáles no.
  ///
  /// `onDelete: SetNull` y no Cascade: borrar una lección no puede borrar
  /// preguntas de un examen que quizá ya se rindió (los intentos guardan su
  /// propia copia en `preguntas_congeladas`, pero el examen vivo sí perdería
  /// una pregunta sin que nadie lo pidiera).
  id_leccion_origen    String?      @db.Uuid
  /// Frase textual (máx. 20 palabras) de la transcripción de la que salió la
  /// pregunta. Es la evidencia que hace revisable una pregunta generada: un
  /// administrador puede leerla y decidir en segundos si la pregunta está
  /// anclada al contenido real o si el modelo se lo inventó.
  fragmento_origen     String?
  /// ¿Se comprobó que `fragmento_origen` aparece de verdad en la
  /// transcripción de `id_leccion_origen`?
  ///
  /// Nullable a propósito, con tres estados y no dos: `null` = no aplica
  /// (pregunta escrita a mano, no hay fragmento que verificar), `true` =
  /// generada y verificada, `false` = generada y NO verificada. Un
  /// `Boolean @default(false)` marcaría como "sin validar" a todas las
  /// preguntas que un administrador escribió él mismo, que es justo al revés
  /// de lo que se quiere leer en el panel.
  ///
  /// Hoy `persistirPreguntasGeneradas()` solo escribe filas con `true` (las
  /// que no validan se descartan antes de llegar a la base); `false` queda
  /// disponible para cuando el panel de admin permita guardar borradores
  /// dudosos para revisión manual.
  validada             Boolean?
  creado_en            DateTime     @default(now()) @db.Timestamptz
  actualizado_en       DateTime     @updatedAt @db.Timestamptz

  examen         Examenes   @relation(fields: [id_examen], references: [id], onDelete: Cascade)
  leccion_origen Lecciones? @relation(fields: [id_leccion_origen], references: [id], onDelete: SetNull)

  @@index([id_examen, orden])
  /// El panel de admin lista "preguntas generadas de este video" al revisar
  /// una lección, y `persistirPreguntasGeneradas` borra por video antes de
  /// reinsertar. Sin índice, ambas cosas hacen seq scan (mismo criterio que
  /// los FK indexados en 20260907010000_indices_fk_faltantes_p2_3).
  @@index([id_leccion_origen])
  @@map("preguntas_examen")
}

/// Un intento de examen de un estudiante.
///
/// `preguntas_congeladas` es el contrato del intento: al iniciarlo se copia
/// ahí la pregunta completa —enunciado, opciones y respuestas correctas— en el
/// orden aleatorizado que le tocó a ESE estudiante. Mismo criterio que el
/// snapshot de `Certificados.nombre_estudiante` (supabase/sql/047): si el
/// admin edita, reordena o borra una pregunta mientras alguien está rindiendo,
/// el intento en curso se califica contra lo que el estudiante realmente vio,
/// no contra lo que quedó en la tabla después.
///
/// Sin `@@unique([id_usuario, id_examen])`: los reintentos son varias filas a
/// propósito (el historial es la evidencia de cuántos intentos consumió). La
/// unicidad que sí importa —un solo intento EN_CURSO por estudiante— la impone
/// el índice parcial `intentos_examen_uno_en_curso` de la migración, que Prisma
/// no sabe expresar.
model IntentosExamen {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_examen            String              @db.Uuid
  id_usuario           String              @db.Uuid
  estado               EstadoIntentoExamen @default(EN_CURSO)
  /// Porcentaje obtenido, 0-100 con dos decimales. `null` mientras EN_CURSO.
  puntaje_pct          Decimal?            @db.Decimal(5, 2)
  /// Copia de `Examenes.nota_aprobatoria` al iniciar: si el admin sube el
  /// umbral después, un intento ya rendido no cambia de resultado.
  nota_requerida       Int
  preguntas_congeladas Json
  /// Respuestas dadas, indexadas por id de pregunta. Se reescribe completo en
  /// cada autoguardado.
  respuestas           Json                @default("{}")
  iniciado_en          DateTime            @default(now()) @db.Timestamptz
  finalizado_en        DateTime?           @db.Timestamptz
  /// Momento a partir del cual el servidor rechaza el envío por tiempo
  /// agotado. Se calcula al iniciar (iniciado_en + minutos_limite) y se
  /// congela acá para que cambiar `minutos_limite` no altere intentos en
  /// curso. `null` = examen sin límite de tiempo.
  expira_en            DateTime?           @db.Timestamptz
  creado_en            DateTime            @default(now()) @db.Timestamptz
  actualizado_en       DateTime            @updatedAt @db.Timestamptz

  examen  Examenes @relation(fields: [id_examen], references: [id], onDelete: Cascade)
  usuario Perfiles @relation(fields: [id_usuario], references: [id])

  @@index([id_usuario, id_examen])
  @@index([id_examen])
  @@map("intentos_examen")
}

/// Transcripción de UN video del curso, tal como la generó Mux.
///
/// Se llena desde el webhook `video.asset.track.ready` (subtítulos
/// autogenerados) y se guarda ACÁ en vez de pedírsela a Mux cada vez que se
/// genera un examen: generar el examen de un curso de 20 clases serían 20
/// descargas de VTT contra stream.mux.com —cada una con su token firmado— en
/// el camino caliente de un clic del administrador. Además, un asset borrado
/// o reemplazado se lleva su transcripción; acá el texto sobrevive al video.
///
/// "Video" en este módulo es una LECCIÓN: es la fila que tiene el asset de
/// Mux (`Lecciones.id_mux_asset_id`) y el título que el examen necesita. Por
/// eso la clave natural es `id_leccion`, no el asset id — aunque el asset id
/// también se guarda, porque es lo único que trae el webhook para encontrar
/// la fila.
model TranscripcionesVideo {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Una transcripción por lección. Un reemplazo de video sobreescribe la
  /// fila (upsert), no crea una segunda: la vieja describe un asset que ya
  /// no se reproduce y generar preguntas con ella sería anclarlas a algo
  /// que el estudiante no puede ver.
  id_leccion     String   @unique @db.Uuid
  /// Desnormalizado a propósito. `lecciones` no tiene `id_curso` (solo
  /// `modulo.id_curso`), así que sin esta columna "todas las
  /// transcripciones del curso" sería un doble JOIN en la consulta que más
  /// se usa de este módulo. Lo escribe el webhook, que ya tiene que leer el
  /// módulo para resolver la lección.
  id_curso       String   @db.Uuid
  /// Asset de Mux del que salió. Es por donde entra el webhook
  /// (`video.asset.track.ready` trae `asset_id`, nunca `upload_id`).
  id_asset_mux   String
  /// Track de texto dentro del asset. Se guarda para poder re-descargar la
  /// misma pista si hiciera falta, y para no confundir dos idiomas.
  id_track_mux   String
  /// Texto plano ya extraído del WebVTT (sin marcas de tiempo ni cues) —
  /// ver `vttATextoPlano()` en src/lib/mux/transcripcion.ts. Es lo que se le
  /// manda al modelo y contra lo que se valida `fragmento_origen`.
  transcripcion  String
  /// BCP 47, tal como lo reporta Mux (`es`, `en`, `es-419`...).
  idioma         String   @default("es")
  creado_en      DateTime @default(now()) @db.Timestamptz
  actualizado_en DateTime @updatedAt @db.Timestamptz

  leccion Lecciones @relation(fields: [id_leccion], references: [id], onDelete: Cascade)
  curso   Cursos    @relation(fields: [id_curso], references: [id], onDelete: Cascade)

  @@index([id_curso])
  @@map("transcripciones_video")
}

/// Una corrida del pipeline "generar el examen de este curso con IA".
///
/// Existe para dos cosas que el examen resultante no puede contar por sí
/// solo: QUÉ disparó la generación y CÓMO terminó (incluido el fallo, con su
/// mensaje). Sin esta tabla, un examen que quedó a medias porque el modelo
/// devolvió basura para tres videos es indistinguible de uno que salió
/// perfecto.
///
/// Idempotencia — las dos reglas, y dónde vive cada una:
///
///   1. No dos corridas simultáneas para el mismo curso. La impone la BASE,
///      con el índice parcial único `trabajos_generacion_examen_uno_pendiente`
///      (solo sobre `estado = 'PENDIENTE'`). Que sea la base y no una
///      comprobación en TypeScript es el punto: dos clics simultáneos son
///      dos procesos distintos y ninguno ve al otro.
///   2. No regenerar sola sobre un examen que ya está bien. La impone
///      `puedeGenerarExamenCurso()` (src/lib/examenes/generacion/trabajo.ts):
///      un disparo VIDEO_AGREGADO se retira si el curso ya tiene preguntas
///      generadas y validadas, mientras que ADMIN_MANUAL siempre procede —
///      "regenerar" es exactamente lo que el administrador pidió.
///
/// Lo que NO dispara esto: el webhook de cada video. `video.asset.track.ready`
/// solo guarda la transcripción y sale.
model TrabajosGeneracionExamen {
  id                   String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_curso             String                        @db.Uuid
  estado               EstadoTrabajoGeneracionExamen @default(PENDIENTE)
  /// Qué originó la corrida. Texto con CHECK en la base en vez de enum de
  /// Postgres, mismo criterio que `eventos_webhook.proveedor`: los valores
  /// los define `DISPARADORES_GENERACION`
  /// (src/lib/examenes/generacion/tipos.ts) y un test falla si las dos
  /// listas se separan. Agregar un disparador no debe costar un
  /// `ALTER TYPE`.
  disparado_por        String
  /// Preguntas que el modelo devolvió y que además superaron
  /// `validateFragment`. Menor que `preguntas_recibidas` cuando el modelo
  /// citó fragmentos que no estaban en la transcripción.
  preguntas_validadas  Int                           @default(0)
  /// Preguntas que el modelo devolvió, antes de validar. La diferencia entre
  /// las dos columnas es la métrica que dice si el prompt está funcionando.
  preguntas_recibidas  Int                           @default(0)
  /// Lecciones que terminaron con CERO preguntas validadas. Es la lista que
  /// un administrador tiene que revisar a mano (transcripción de mala
  /// calidad, audio con ruido, clase sin narración). Se loguea además con
  /// `logError(..., { area: "exam-generation", videoId })`.
  videos_sin_preguntas String[]
  /// Mensaje del fallo cuando `estado = FALLIDO`. Null en cualquier otro
  /// estado.
  error                String?
  finalizado_en        DateTime?                     @db.Timestamptz
  creado_en            DateTime                      @default(now()) @db.Timestamptz
  actualizado_en       DateTime                      @updatedAt @db.Timestamptz

  curso Cursos @relation(fields: [id_curso], references: [id], onDelete: Cascade)

  @@index([id_curso, creado_en])
  @@map("trabajos_generacion_examen")
}

// ============================================================
// Módulo de Operaciones y Seguimiento
// ============================================================

model Progreso {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_usuario     String   @db.Uuid
  id_leccion     String   @db.Uuid
  completado     Boolean  @default(false)
  segundo_actual Int      @default(0)
  creado_en      DateTime @default(now()) @db.Timestamptz
  actualizado_en DateTime @updatedAt @db.Timestamptz

  usuario Perfiles  @relation(fields: [id_usuario], references: [id])
  leccion Lecciones @relation(fields: [id_leccion], references: [id], onDelete: Cascade)

  @@unique([id_usuario, id_leccion])
  @@index([id_leccion])
  @@map("progreso")
}

model Certificados {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_usuario          String    @db.Uuid
  id_curso            String    @db.Uuid
  fecha_emision       DateTime  @default(now()) @db.Timestamptz
  actualizado_en      DateTime  @updatedAt @db.Timestamptz
  codigo_verificacion String    @unique
  archivo_pdf         String?
  /// Snapshot congelado al momento de la emisión (Deteccion.md, requisitos
  /// de calidad senior): un certificado ya expedido no debe cambiar si el
  /// estudiante corrige su nombre en Perfiles o si el curso se renombra
  /// después. Los escribe el trigger de emisión (supabase/sql/047), nunca
  /// la aplicación — verificar_certificado() (015) y la generación del PDF
  /// (descargarCertificadoPdf) leen estas columnas, no perfiles/cursos.
  nombre_estudiante   String
  nombre_curso        String
  /// NULL = correo de "certificado listo" pendiente de enviar; timestamp =
  /// ya enviado. Lo actualiza scripts/certificados-enviar-notificaciones.ts
  /// (outbox), nunca un Server Action ni el trigger de emisión — este
  /// corre SECURITY DEFINER en la sesión del estudiante y no tiene forma
  /// de hacer una llamada de red desde Postgres sin depender de
  /// extensiones adicionales (mismo criterio que
  /// mux_assets_pendientes_eliminacion / mux-limpiar-assets.ts).
  notificado_en       DateTime? @db.Timestamptz

  usuario Perfiles @relation(fields: [id_usuario], references: [id])
  curso   Cursos   @relation(fields: [id_curso], references: [id])

  @@unique([id_usuario, id_curso])
  @@index([id_curso])
  @@map("certificados")
}

/// Código canjeable por acceso completo a la plataforma (equivalente a un
/// plan de cortesía), ver docs/functional-spec.md y auditoría de RLS. El
/// canje lo resuelve un Server Action con Service Role Key (mismo patrón
/// que Cupones en checkout): valida vigencia/límite de uso y crea la fila
/// de Suscripciones — nunca un INSERT directo del cliente contra esta
/// tabla ni contra Suscripciones.
/// Código que un estudiante canjea para obtener acceso, sin pasar por
/// ninguna pasarela de pago (MVP del 12 de septiembre de 2026).
///
/// NO apunta a un `Planes`: un código no vende un plan, regala un periodo
/// de acceso que el administrador fija libremente en `duracion_dias`. Antes
/// sí tenía `id_plan` y el canje sacaba de ahí la duración, lo que obligaba
/// al admin a traducir "quiero dar 45 días" a "elijo el plan que dure 45
/// días" — y a crear un plan falso cuando no existía ninguno con esa
/// duración.
model CodigosInvitacion {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo            String   @unique
  /// Días de acceso que otorga el canje, contados desde el momento de
  /// canjear. Lo usa public.canjear_codigo_invitacion() para calcular
  /// `suscripciones.fecha_renovacion`.
  duracion_dias     Int
  id_admin_creador  String?  @db.Uuid
  /// `@db.Timestamptz` por el mismo motivo que las fechas de `Suscripciones`:
  /// las vistas de métricas y el canje la comparan contra `now()`, y sin zona
  /// esa comparación dependía de la TimeZone de la sesión.
  fecha_vencimiento DateTime @db.Timestamptz
  /// Cuántas veces se puede canjear. Obligatorio y con CHECK >= 1 en la
  /// base (`codigos_invitacion_limite_usos_positivo`, ver la migración
  /// 20260827000000): la regla de negocio es "uso único o con límite,
  /// nunca ilimitado", y dejarlo nullable permitía crear por descuido un
  /// código que cualquiera puede repartir sin tope.
  limite_usos       Int
  veces_usado       Int      @default(0)
  activo            Boolean  @default(true)
  creado_en         DateTime @default(now()) @db.Timestamptz
  actualizado_en    DateTime @updatedAt @db.Timestamptz
  /// Presente SOLO en los códigos que salieron de "Lote de códigos"
  /// (crear_lote_codigos_invitacion, 045). Un código creado con "Código
  /// único" (crearCodigoInvitacion) siempre lo tiene NULL. Sirve para
  /// agrupar en la pantalla de lotes y para el filtro de exportación CSV;
  /// no cambia nada del canje, que sigue operando fila por fila igual que
  /// siempre.
  id_lote           String?  @db.Uuid

  admin_creador Perfiles?               @relation("CodigosInvitacionCreadosPorAdmin", fields: [id_admin_creador], references: [id])
  lote          LotesCodigosInvitacion? @relation(fields: [id_lote], references: [id])
  suscripciones Suscripciones[]

  @@index([id_lote])
  /// P2-3 (AUDIT-2026-09-04.md): "códigos creados por este administrador"
  /// hacía seq scan sin esto.
  @@index([id_admin_creador])
  @@map("codigos_invitacion")
}

/// Cabecera de una generación masiva de códigos de invitación (opción "Lote
/// de códigos", alternativa a "Código único con cupo N" — ver rev.md: la
/// decisión de qué modo de distribución usar en producción sigue pendiente
/// de confirmación de negocio, así que ambos conviven hasta que se resuelva).
///
/// Existe para no escribir una fila de bitácora por cada uno de los N
/// códigos generados ("Generó 100 códigos" en una sola entrada, no 100), y
/// para poder listar/exportar un lote como unidad. Los códigos en sí viven
/// en `CodigosInvitacion` (uno por fila, `limite_usos = 1` cada uno): esta
/// tabla no duplica su estado, solo agrupa.
model LotesCodigosInvitacion {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Cuántos códigos se pidieron generar. Se guarda aparte de `count(codigos)`
  /// porque es un hecho fijado al crear el lote (como `duracion_dias` en un
  /// código), no un estado que cambie con el tiempo.
  cantidad          Int
  duracion_dias     Int
  fecha_vencimiento DateTime @db.Timestamptz
  id_admin_creador  String?  @db.Uuid
  creado_en         DateTime @default(now()) @db.Timestamptz

  admin_creador Perfiles?           @relation("LotesCodigosCreadosPorAdmin", fields: [id_admin_creador], references: [id])
  codigos       CodigosInvitacion[]

  /// P2-3 (AUDIT-2026-09-04.md): "lotes creados por este administrador"
  /// hacía seq scan sin esto.
  @@index([id_admin_creador])
  @@map("lotes_codigos_invitacion")
}

/// Descuento aplicable en el checkout — entidad DISTINTA de
/// `CodigosInvitacion`, que regala acceso sin pasar por caja. Sin uso en el
/// código todavía: existe para cuando llegue el cobro.
model Cupones {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo            String        @unique
  tipo_descuento    TipoDescuento
  /// OJO — la unidad depende de `tipo_descuento`: centavos cuando es
  /// MONTO_FIJO, y un porcentaje entero (0-100) cuando es PORCENTAJE. Una sola
  /// columna para dos unidades; quien la lea tiene que ramificar. BigInt por
  /// la mitad de los casos que sí son dinero.
  valor             BigInt
  fecha_vencimiento DateTime      @db.Timestamptz
  limite_usos       Int?
  veces_usado       Int           @default(0)
  creado_en         DateTime      @default(now()) @db.Timestamptz
  actualizado_en    DateTime      @updatedAt @db.Timestamptz

  suscripciones Suscripciones[]

  @@map("cupones")
}

model Inscripciones {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_usuario        String     @db.Uuid
  id_curso          String     @db.Uuid
  otorgado_por      String?    @db.Uuid
  tipo_acceso       TipoAcceso
  /// Revocar (f4accesos.md) no borra la fila — la marca inactiva. Sigue
  /// siendo la única forma de reconciliar el índice único
  /// (id_usuario, id_curso): un re-otorgamiento después de revocar
  /// reactiva esta misma fila en vez de intentar insertar una segunda
  /// (ver ofrecerCortesia, src/actions/admin/usuarios.ts).
  activo            Boolean    @default(true)
  revocado_en       DateTime?  @db.Timestamptz
  motivo_revocacion String?
  revocado_por      String?    @db.Uuid
  creado_en         DateTime   @default(now()) @db.Timestamptz
  actualizado_en    DateTime   @updatedAt @db.Timestamptz

  usuario      Perfiles  @relation("InscripcionesDelUsuario", fields: [id_usuario], references: [id])
  curso        Cursos    @relation(fields: [id_curso], references: [id])
  admin_otorgo Perfiles? @relation("InscripcionesOtorgadasPorAdmin", fields: [otorgado_por], references: [id])
  admin_revoco Perfiles? @relation("InscripcionesRevocadasPorAdmin", fields: [revocado_por], references: [id])

  @@unique([id_usuario, id_curso])
  @@index([id_curso])
  /// P2-3 (AUDIT-2026-09-04.md): "otorgamientos/revocaciones de este
  /// administrador" hacía seq scan sin esto.
  @@index([otorgado_por])
  @@index([revocado_por])
  @@map("inscripciones")
}

model BitacoraAdministrativa {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_admin            String   @db.Uuid
  accion              String
  id_entidad_afectada String?  @db.Uuid
  entidad_afectada    String
  /// Log de solo-lectura (append-only): a propósito no tiene
  /// actualizado_en, ver docs/technical-spec.md — una fila de bitácora
  /// nunca se edita después de creada.
  creado_en           DateTime @default(now()) @db.Timestamptz
  detalles            String?

  admin Perfiles @relation(fields: [id_admin], references: [id])

  @@index([id_admin])
  @@map("bitacora_administrativa")
}

/// Bitácora de idempotencia de TODO webhook entrante (CLAUDE.md §3.1: se
/// registra aquí antes de ejecutar cualquier lógica de negocio). No es solo de
/// pagos: `proveedor` incluye 'mux', que no cobra nada — por eso el CHECK de
/// esta tabla admite un conjunto distinto al de `pagos`.
///
/// RLS activo SIN política (supabase/sql/003): nadie la lee ni la escribe
/// salvo el backend con Service Role Key.
model EventosWebhook {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proveedor         String
  /// Identificador del evento del lado del proveedor: `evt_...` en Stripe, un
  /// UUID en Mux, y en Wompi el checksum SHA-256 del propio evento (no manda
  /// id, ver el comentario en app/api/webhooks/wompi/route.ts).
  id_evento_externo String
  tipo_evento       String
  payload           Json
  procesado         Boolean  @default(false)
  creado_en         DateTime @default(now()) @db.Timestamptz
  actualizado_en    DateTime @updatedAt @db.Timestamptz

  @@unique([proveedor, id_evento_externo])
  @@map("eventos_webhook")
}

/// Comentario de un estudiante (o profesor) en el hilo de UNA lección — no
/// de un curso completo (decisión de producto: cada clase tiene su propio
/// hilo, estilo Udemy). Un solo nivel de respuestas: `id_comentario_padre`
/// solo puede apuntar a un comentario raíz (se valida en el Server Action,
/// no aquí — Prisma/Postgres no expresan "el padre de mi padre debe ser
/// null").
model Comentarios {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_leccion          String   @db.Uuid
  id_usuario          String   @db.Uuid
  id_comentario_padre String?  @db.Uuid
  /// Vacío desde que el comentario está `eliminado`: el borrado lógico ya
  /// no conserva el texto acá (ver actions/comentarios/eliminar.ts) porque
  /// RLS solo protege filas, no columnas — cualquiera con acceso a la
  /// lección podía leer el contenido "borrado" directo desde el cliente.
  /// La copia para moderación de un borrado hecho por un admin vive en
  /// `ComentarioModeracion`, con su propio RLS solo-admin.
  contenido           String
  /// Borrado lógico, nunca DELETE: un comentario raíz puede tener
  /// respuestas, y borrarlas junto con él las dejaría huérfanas de
  /// contexto. La UI muestra "[comentario eliminado]" y conserva el hilo.
  eliminado           Boolean  @default(false)
  creado_en           DateTime @default(now()) @db.Timestamptz
  actualizado_en      DateTime @updatedAt @db.Timestamptz

  leccion    Lecciones              @relation(fields: [id_leccion], references: [id], onDelete: Cascade)
  usuario    Perfiles               @relation(fields: [id_usuario], references: [id])
  padre      Comentarios?           @relation("Respuestas", fields: [id_comentario_padre], references: [id], onDelete: Cascade)
  respuestas Comentarios[]          @relation("Respuestas")
  likes      ComentarioLikes[]
  moderacion ComentarioModeracion[]

  @@index([id_leccion, creado_en])
  @@index([id_comentario_padre])
  /// P2-3 (AUDIT-2026-09-04.md): comentarios_autor_publico (061) hace join
  /// c.id_usuario = p.id por cada fila de perfiles -- sin este índice, cada
  /// carga de un hilo de comentarios es un seq scan completo de la tabla.
  @@index([id_usuario])
  @@map("comentarios")
}

model ComentarioLikes {
  id_comentario String   @db.Uuid
  id_usuario    String   @db.Uuid
  creado_en     DateTime @default(now()) @db.Timestamptz

  comentario Comentarios @relation(fields: [id_comentario], references: [id], onDelete: Cascade)
  usuario    Perfiles    @relation(fields: [id_usuario], references: [id])

  @@id([id_comentario, id_usuario])
  /// P2-3 (AUDIT-2026-09-04.md): la PK compuesta de arriba solo sirve como
  /// índice para buscar por id_comentario (o por ambas columnas) --
  /// Postgres no puede usar el sufijo para filtrar solo por id_usuario.
  @@index([id_usuario])
  @@map("comentario_likes")
}

/// Evidencia de un comentario que un ADMINISTRADOR eliminó por moderación
/// (no el propio autor): guarda el texto que `comentarios.contenido` ya
/// perdió al vaciarse, para no quedarse sin rastro de un comentario abusivo.
/// RLS (065_comentario_moderacion.sql) restringe SELECT a administradores;
/// nadie más puede leer esta tabla.
model ComentarioModeracion {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_comentario      String   @db.Uuid
  contenido_original String
  id_eliminado_por   String   @db.Uuid
  creado_en          DateTime @default(now()) @db.Timestamptz

  comentario    Comentarios @relation(fields: [id_comentario], references: [id], onDelete: Cascade)
  eliminado_por Perfiles    @relation(fields: [id_eliminado_por], references: [id])

  @@index([id_comentario])
  /// P2-3 (AUDIT-2026-09-04.md): sin esto, "todo lo que moderó este
  /// administrador" hace seq scan -- encontrado por check-fk-indexes.ts al
  /// escribir el gate de CI para el propio hallazgo, el mismo día que esta
  /// tabla llegó por otra rama.
  @@index([id_eliminado_por])
  @@map("comentario_moderacion")
}

model RecursosDescargables {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_leccion     String   @db.Uuid
  nombre         String
  tipo_archivo   String
  url_archivo    String
  tamano_bytes   Int?
  creado_en      DateTime @default(now()) @db.Timestamptz
  actualizado_en DateTime @updatedAt @db.Timestamptz

  leccion Lecciones @relation(fields: [id_leccion], references: [id])

  @@index([id_leccion])
  @@map("recursos_descargables")
}

// ============================================================
// Comunidad — F1 del plan (ver conversación de diseño, sept. 2026)
//
// Gate de acceso: private.comunidad_tiene_acceso() en supabase/sql/083, no
// aquí — mismo criterio que curso_esta_completo (068): una sola fuente de
// verdad en SQL, la app la consulta por el wrapper público, nunca reimplementa
// la regla en TypeScript.
// ============================================================

/// Fila única (id = 1, forzado por CHECK en 083) que fijaba cuándo terminaba
/// la ventana de "comunidad abierta a cualquier suscriptor" (bootstrap) y se
/// pasaba a exigir curso completado en los últimos 30 días.
///
/// PARQUEADA desde 084_comunidad_gate_sin_requisito_temporal.sql: por
/// decisión de negocio, el gate quedó reducido a "suscripción vigente O
/// administrador", sin ventana de tiempo, mientras la comunidad no tenga
/// masa crítica. La tabla y su RLS siguen existiendo sin usarse — no se
/// borra nada — para poder reintroducir el requisito más adelante sin
/// rediseñar el esquema, solo reescribiendo esa función.
model ConfiguracionComunidad {
  id              Int      @id @default(1)
  fin_bootstrap   DateTime @db.Timestamptz
  actualizado_en  DateTime @default(now()) @updatedAt @db.Timestamptz
  actualizado_por String?  @db.Uuid

  admin_actualizo Perfiles? @relation("ConfiguracionComunidadActualizadaPorAdmin", fields: [actualizado_por], references: [id])

  @@index([actualizado_por])
  @@map("configuracion_comunidad")
}

model ComunidadPosts {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_usuario     String             @db.Uuid
  categoria      CategoriaComunidad
  titulo         String
  contenido      String
  /// Borrado lógico, mismo criterio que Comentarios.eliminado: conserva el
  /// hilo de respuestas en vez de dejarlas huérfanas.
  eliminado      Boolean            @default(false)
  /// `true` solo cuando `eliminado` lo puso un admin moderando (no el propio
  /// autor) — distingue el placeholder en la UI. Solo se setea junto con
  /// `eliminado`, verificado en el trigger de transiciones (089), no aquí.
  eliminado_por_admin Boolean       @default(false)
  /// Solo ADMINISTRADOR — verificado en la policy de UPDATE (083), no aquí.
  fijado         Boolean            @default(false)
  creado_en      DateTime           @default(now()) @db.Timestamptz
  actualizado_en DateTime           @default(now()) @updatedAt @db.Timestamptz

  usuario    Perfiles              @relation(fields: [id_usuario], references: [id])
  respuestas ComunidadRespuestas[]
  reacciones ComunidadReacciones[]
  moderacion ComunidadModeracion[]
  adjuntos   ComunidadAdjuntos[]
  reportes   ComunidadReportes[]

  @@index([categoria, creado_en])
  @@index([id_usuario])
  @@map("comunidad_posts")
}

model ComunidadRespuestas {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_post        String   @db.Uuid
  id_usuario     String   @db.Uuid
  contenido      String
  eliminado      Boolean  @default(false)
  /// Ver el comentario del mismo campo en ComunidadPosts.
  eliminado_por_admin Boolean @default(false)
  creado_en      DateTime @default(now()) @db.Timestamptz
  actualizado_en DateTime @default(now()) @updatedAt @db.Timestamptz

  post       ComunidadPosts        @relation(fields: [id_post], references: [id], onDelete: Cascade)
  usuario    Perfiles              @relation(fields: [id_usuario], references: [id])
  reacciones ComunidadReacciones[]
  moderacion ComunidadModeracion[]
  adjuntos   ComunidadAdjuntos[]
  reportes   ComunidadReportes[]

  @@index([id_post, creado_en])
  @@index([id_usuario])
  @@map("comunidad_respuestas")
}

/// Reacciona a un post O a una respuesta, nunca a ambos — la exclusividad y
/// el índice único (por usuario + objeto) viven como SQL crudo en 083, mismo
/// motivo que las dos parciales de Suscripciones: Prisma no soporta CHECK ni
/// unique con WHERE de forma nativa.
model ComunidadReacciones {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_post      String?  @db.Uuid
  id_respuesta String?  @db.Uuid
  id_usuario   String   @db.Uuid
  creado_en    DateTime @default(now()) @db.Timestamptz

  post      ComunidadPosts?      @relation(fields: [id_post], references: [id], onDelete: Cascade)
  respuesta ComunidadRespuestas? @relation(fields: [id_respuesta], references: [id], onDelete: Cascade)
  usuario   Perfiles             @relation(fields: [id_usuario], references: [id])

  @@index([id_post])
  @@index([id_respuesta])
  @@index([id_usuario])
  @@map("comunidad_reacciones")
}

/// Igual que ComentarioModeracion: evidencia del texto que un ADMINISTRADOR
/// borró por moderación (no el propio autor), porque el borrado lógico ya
/// vacía `contenido`/`ComunidadRespuestas.contenido`. Apunta a un post O a una
/// respuesta, mismo patrón de exclusividad que ComunidadReacciones.
model ComunidadModeracion {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_post            String?  @db.Uuid
  id_respuesta       String?  @db.Uuid
  contenido_original String
  id_eliminado_por   String   @db.Uuid
  /// Razón que escribió el admin al moderar — obligatoria a nivel de
  /// aplicación (eliminarPostComunidad/eliminarRespuestaComunidad) para
  /// poder informarle el motivo al autor por correo. Nullable en la
  /// columna, no con CHECK: filas de antes de este campo (si las hay) no
  /// deben romper la migración.
  motivo             String?
  creado_en          DateTime @default(now()) @db.Timestamptz

  post          ComunidadPosts?      @relation(fields: [id_post], references: [id], onDelete: Cascade)
  respuesta     ComunidadRespuestas? @relation(fields: [id_respuesta], references: [id], onDelete: Cascade)
  eliminado_por Perfiles             @relation("ComunidadModeradaPorAdmin", fields: [id_eliminado_por], references: [id])

  @@index([id_post])
  @@index([id_respuesta])
  @@index([id_eliminado_por])
  @@map("comunidad_moderacion")
}

/// Denuncia de un usuario sobre un post O una respuesta ajenos (mismo patrón
/// de exclusividad que ComunidadReacciones/ComunidadModeracion). No oculta
/// ni afecta el contenido reportado por sí sola — solo alimenta la cola de
/// moderación en /admin/comunidad. `revisado` lo marca un admin al
/// descartar el reporte sin eliminar el contenido; si lo elimina, el
/// reporte queda igual con `revisado = true` (ver resolverReporteComunidad).
model ComunidadReportes {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_post        String?  @db.Uuid
  id_respuesta   String?  @db.Uuid
  id_reportante  String   @db.Uuid
  motivo         String
  revisado       Boolean  @default(false)
  creado_en      DateTime @default(now()) @db.Timestamptz

  post       ComunidadPosts?      @relation(fields: [id_post], references: [id], onDelete: Cascade)
  respuesta  ComunidadRespuestas? @relation(fields: [id_respuesta], references: [id], onDelete: Cascade)
  reportante Perfiles             @relation("ComunidadReportadaPor", fields: [id_reportante], references: [id])

  @@index([id_post])
  @@index([id_respuesta])
  @@index([id_reportante])
  @@index([revisado, creado_en])
  @@map("comunidad_reportes")
}

/// Notificación in-app genérica — hoy solo la dispara el trigger
/// `comunidad_respuestas_notifica_autor` (094_comunidad_notificaciones.sql)
/// cuando alguien responde tu post, pero el `tipo` abierto (no un enum)
/// deja sumar más disparadores después (reacciones, anuncios) sin
/// migración de esquema. Nunca la inserta la app directo: no hay policy de
/// INSERT para `authenticated`, solo el trigger (SECURITY DEFINER) decide
/// qué es una notificación legítima y para quién — mismo criterio que
/// `intento_examen_emite_certificado` (068), nunca confiar en que el
/// cliente diga a quién le llega un aviso.
model Notificaciones {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_usuario   String   @db.Uuid
  /// 'COMUNIDAD_RESPUESTA' por ahora. Texto libre a propósito (ver el
  /// comentario de arriba), acotado por CHECK en SQL, no por un enum de
  /// Prisma que exigiría una migración por cada tipo nuevo.
  tipo         String
  /// Quién generó el aviso (quien respondió, quien reaccionó...). Puede
  /// ser null si algún día hay un tipo sin actor (un anuncio del sistema).
  id_actor     String?  @db.Uuid
  /// A qué entidad de comunidad apunta el link ("comunidad_post"), y su id
  /// — misma pareja (tipo, id) suelta que ya usa comunidad_moderacion en
  /// vez de una FK por tabla, porque el link varía según `tipo`.
  entidad_tipo String
  entidad_id   String   @db.Uuid
  leida        Boolean  @default(false)
  creado_en    DateTime @default(now()) @db.Timestamptz

  usuario Perfiles  @relation("NotificacionesDelUsuario", fields: [id_usuario], references: [id], onDelete: Cascade)
  actor   Perfiles? @relation("NotificacionesGeneradasPorActor", fields: [id_actor], references: [id], onDelete: SetNull)

  @@index([id_usuario, leida, creado_en])
  @@map("notificaciones")
}

/// Un archivo adjunto (imagen o documento) de un post O una respuesta, nunca
/// ambos — mismo patrón de exclusividad que ComunidadReacciones. Puede haber
/// varios por post/respuesta: cada uno corresponde a un marcador
/// `[[adjunto:<id>]]` en el `contenido` de ese post/respuesta (src/lib/
/// formato-texto.tsx), en el punto exacto donde el autor lo insertó al
/// escribir. Inmutable: no hay UPDATE, se elimina y se vuelve a adjuntar.
/// `ancho`/`alto` solo aplican a `es_imagen = true` — el feed los usa para
/// reservar el espacio antes de que la imagen cargue.
model ComunidadAdjuntos {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_post         String?  @db.Uuid
  id_respuesta    String?  @db.Uuid
  id_usuario      String   @db.Uuid
  ruta_storage    String
  nombre_original String
  tipo_archivo    String
  es_imagen       Boolean
  ancho           Int?
  alto            Int?
  tamano_bytes    Int
  creado_en       DateTime @default(now()) @db.Timestamptz

  post      ComunidadPosts?      @relation(fields: [id_post], references: [id], onDelete: Cascade)
  respuesta ComunidadRespuestas? @relation(fields: [id_respuesta], references: [id], onDelete: Cascade)
  usuario   Perfiles             @relation(fields: [id_usuario], references: [id])

  @@index([id_post])
  @@index([id_respuesta])
  @@index([id_usuario])
  @@map("comunidad_adjuntos")
}
