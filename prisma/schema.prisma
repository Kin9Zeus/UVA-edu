// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums — ver docs/technical-spec.md sección 4 (Diccionario de Datos)
// ============================================================

enum RolPerfil {
  ESTUDIANTE
  ADMINISTRADOR
}

enum EstadoPerfil {
  ACTIVO
  SUSPENDIDO
}

enum EstadoSuscripcion {
  ACTIVA
  PAST_DUE
  VENCIDA
  CANCELADA
}

/// REEMBOLSADO y REVERSADO existen desde el diseño, aunque hoy ninguna
/// pasarela esté conectada: sin ellos, registrar una devolución obligaría a
/// mutar la fila del pago original y destruir el rastro contable. El
/// Estatuto del Consumidor colombiano da derecho de retracto en ventas a
/// distancia, y `ref_factura_dian` ya anticipa la factura electrónica —
/// cuya contraparte de una devolución es la nota crédito.
///
/// REEMBOLSADO: devolvimos el dinero al estudiante.
/// REVERSADO:   la pasarela o el banco anularon la transacción (contracargo),
///              sin que mediara una devolución nuestra.
enum EstadoPago {
  EXITOSO
  FALLIDO
  PENDIENTE
  REEMBOLSADO
  REVERSADO
}

enum EstadoProcesamientoLeccion {
  SUBIENDO
  PROCESANDO
  LISTO
  ERROR
}

enum TipoDescuento {
  PORCENTAJE
  MONTO_FIJO
}

/// Nivel de dificultad del curso, usado en filtros del catálogo y del
/// panel admin (ver prompt-panel-admin-claude-code.md). No estaba en el
/// diccionario de datos original de docs/technical-spec.md; se agrega
/// aquí como campo del CMS.
enum NivelCurso {
  BASICO
  INTERMEDIO
  AVANZADO
}

/// MEMBRESIA: alta automática al entrar por primera vez a un curso con
/// Suscripción activa (no es una compra separada). CORTESIA: acceso manual
/// otorgado por un Administrador a un estudiante específico, con fecha de
/// expiración obligatoria (ver docs/functional-spec.md Flujo 11).
enum TipoAcceso {
  MEMBRESIA
  CORTESIA
}

// ============================================================
// Módulo de Usuarios y Membresía
// ============================================================

/// La contraseña y el proveedor de login viven en auth.users de Supabase.
/// `id` se sincroniza vía trigger de Postgres (ver docs/technical-spec.md §6),
/// no como Foreign Key real de Prisma hacia el esquema `auth`.
model Perfiles {
  id             String       @id @db.Uuid
  nombre         String
  correo         String       @unique
  celular        String?
  rol            RolPerfil    @default(ESTUDIANTE)
  estado         EstadoPerfil @default(ACTIVO)
  creado_en      DateTime     @default(now()) @db.Timestamptz
  actualizado_en DateTime     @updatedAt @db.Timestamptz

  cursos_creados              Cursos[]                 @relation("CursosCreadosPorAdmin")
  categorias_creadas          Categorias[]             @relation("CategoriasCreadasPorAdmin")
  instructores_creados        Instructores[]           @relation("InstructoresCreadosPorAdmin")
  codigos_invitacion_creados  CodigosInvitacion[]      @relation("CodigosInvitacionCreadosPorAdmin")
  tokens_vista_previa_creados TokensVistaPrevia[]      @relation("TokensVistaPreviaCreadosPorAdmin")
  suscripciones               Suscripciones[]          @relation("SuscripcionesDelUsuario")
  suscripciones_otorgadas     Suscripciones[]          @relation("SuscripcionesOtorgadasPorAdmin")
  suscripciones_canceladas    Suscripciones[]          @relation("SuscripcionesCanceladasPorAdmin")
  progreso                    Progreso[]
  certificados                Certificados[]
  inscripciones               Inscripciones[]          @relation("InscripcionesDelUsuario")
  inscripciones_otorgadas     Inscripciones[]          @relation("InscripcionesOtorgadasPorAdmin")
  inscripciones_revocadas     Inscripciones[]          @relation("InscripcionesRevocadasPorAdmin")
  acciones_bitacora           BitacoraAdministrativa[]

  @@map("perfiles")
}

/// Catálogo de planes de membresía. `precio_centavos` + `moneda` son el
/// precio de REFERENCIA que muestra el catálogo público; lo que efectivamente
/// se cobra a través de cada pasarela vive en `PlanesPrecios`, porque el mismo
/// plan necesita precio en COP (Wompi) y en USD (Stripe).
///
/// Hoy la tabla se usa sin cobro: `otorgarMembresia` lee `duracion_dias` para
/// calcular hasta cuándo dura un acceso otorgado a mano.
model Planes {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre          String
  descripcion     String?
  /// BigInt, no Int: en centavos de peso colombiano un INTEGER de 4 bytes
  /// tope en $21.474.836, y Postgres no trunca — lanza 22003 y el INSERT
  /// falla. Ver la migración `esquema_listo_para_cobro`.
  precio_centavos BigInt
  /// ISO-4217 en mayúsculas ('COP', 'USD'). Lo garantiza un CHECK en la base
  /// (supabase/sql/042): `formatMoneda` se lo pasa a Intl.NumberFormat, que
  /// lanza RangeError con cualquier otra cosa y tumbaría la pantalla.
  moneda          String
  duracion_dias   Int
  nivel_acceso    String?
  activo          Boolean  @default(true)
  orden           Int      @default(0)
  creado_en       DateTime @default(now()) @db.Timestamptz
  actualizado_en  DateTime @updatedAt @db.Timestamptz

  suscripciones Suscripciones[]
  precios       PlanesPrecios[]

  @@map("planes")
}

/// Precio de un plan EN una pasarela concreta. Tabla vacía a propósito:
/// llenarla es parte de la integración de cobro, que está diferida.
///
/// Resuelve dos cosas de una vez, sin tocar `Planes`:
///   1. El mapeo plan → precio del proveedor. Sin él no hay contra qué
///      conciliar un webhook, que es literalmente lo que dice el TODO de
///      `src/app/api/webhooks/stripe/route.ts`.
///   2. El precio por moneda. `Planes` tiene una sola pareja precio/moneda,
///      pero docs/technical-spec.md define Stripe para facturación
///      internacional y Wompi para Colombia.
///
/// Para enchufar una pasarela se insertan filas aquí y se lee
/// `id_precio_externo` desde el webhook. Ninguna tabla existente cambia.
model PlanesPrecios {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_plan           String   @db.Uuid
  /// Genérico, nunca una columna por pasarela ('id_precio_stripe'). Valores
  /// admitidos acotados por CHECK en supabase/sql/042 y por
  /// `PROVEEDORES_PASARELA` en src/lib/pagos/proveedores.ts.
  proveedor         String
  /// El identificador del lado del proveedor (`price_...` en Stripe): es lo
  /// que llega en el webhook.
  id_precio_externo String
  monto_centavos    BigInt
  moneda            String
  /// Retirar un precio sin borrar la fila: los pagos históricos tienen que
  /// seguir pudiendo explicarse.
  activo            Boolean  @default(true)
  creado_en         DateTime @default(now()) @db.Timestamptz
  actualizado_en    DateTime @updatedAt @db.Timestamptz

  plan Planes @relation(fields: [id_plan], references: [id], onDelete: Restrict)

  @@unique([id_plan, proveedor, moneda])
  @@unique([proveedor, id_precio_externo])
  @@index([id_plan])
  @@map("planes_precios")
}

/// El "permiso de acceso" de la plataforma. Una fila aquí es lo que abre el
/// contenido, venga de donde venga: `proveedor` es lo único que distingue una
/// invitación canjeada de un acceso otorgado a mano o de un cobro por
/// pasarela. Por eso enchufar Stripe no toca el muro de acceso —
/// `tieneAccesoVigente()` (src/lib/mux/acceso.ts) solo mira `estado` y
/// `fecha_renovacion`, nunca el origen.
///
/// Un índice único parcial (`suscripcion_activa_unica_por_usuario`) admite a
/// lo sumo UNA fila en ACTIVA o PAST_DUE por usuario. Consecuencia a tener
/// presente cuando llegue el cobro: no se puede modelar una renovación
/// programada ni un cambio de plan solapado sin cerrar antes la vigente.
model Suscripciones {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_usuario             String            @db.Uuid
  /// Nullable: un acceso otorgado por código de invitación no compró ningún
  /// plan, así que no tiene ninguno que referenciar. Las suscripciones de
  /// pago (Stripe/Wompi) y las que otorga el admin a mano sí lo llenan.
  /// Quien lo lee debe tener un valor por defecto — ver `lib/suscripcion.ts`
  /// y `lib/admin/usuarioDetalle.ts`, que muestran "Acceso por invitación".
  id_plan                String?           @db.Uuid
  /// `@db.Timestamptz` no es decorativo: `private.suscripcion_da_acceso()`
  /// hace `fecha_renovacion AT TIME ZONE 'America/Bogota'`, y esa expresión
  /// significa cosas OPUESTAS según el tipo — sobre `timestamptz` convierte un
  /// instante a hora de pared (lo correcto), sobre un `timestamp` desnudo
  /// interpreta la hora de pared como si fuera de esa zona. Mientras fueron
  /// `timestamp`, toda membresía otorgada después de las 2 p.m. hora de
  /// Colombia vencía un día tarde. Además Stripe envía `current_period_end`
  /// como epoch Unix: un instante absoluto, que sin zona pierde su sentido.
  fecha_inicio           DateTime          @db.Timestamptz
  fecha_renovacion       DateTime?         @db.Timestamptz
  estado                 EstadoSuscripcion
  /// El ORIGEN del acceso, y el único campo que hay que mirar para saber de
  /// dónde salió: 'invitacion' (código canjeado), 'manual' (otorgado por un
  /// admin) y, cuando llegue el cobro, 'stripe' o 'wompi'. Genérico a
  /// propósito, nunca acoplado a una pasarela concreta. Valores admitidos en
  /// src/lib/pagos/proveedores.ts, sellados por CHECK en supabase/sql/042.
  proveedor              String
  id_cliente_externo     String?
  id_suscripcion_externa String?
  /// BigInt por el techo de $21.474.836 COP de un INTEGER en centavos.
  /// NOT NULL, así que las invitaciones escriben 0: un acceso gratuito no
  /// tiene monto, pero la columna no admite ausencia.
  monto_centavos         BigInt
  /// ISO-4217 en mayúsculas, garantizado por CHECK en supabase/sql/042.
  moneda                 String
  id_cupon               String?           @db.Uuid
  id_codigo_invitacion   String?           @db.Uuid
  /// Redundante con `proveedor` a propósito: equivale exactamente a
  /// `proveedor IN ('manual','invitacion')`. Se conserva porque la leen seis
  /// módulos, pero un CHECK (supabase/sql/042) sella la equivalencia para que
  /// las dos columnas no puedan contradecirse.
  acceso_manual          Boolean           @default(false)
  otorgado_por           String?           @db.Uuid
  /// Motivo que el admin escribió al revocar (f4accesos.md: "marca inactivo
  /// con fecha y motivo"). Null mientras la suscripción nunca se canceló a
  /// mano. La fecha es `actualizado_en` — ya se refresca en cada UPDATE, no
  /// hace falta una columna aparte solo para el momento de la revocación.
  motivo_cancelacion     String?
  /// Quién ejecutó la cancelación manual (revocarMembresia). Null si la
  /// suscripción nunca se canceló, o si se cerró sola por vencimiento de
  /// fecha (038_vigencia_por_fecha.sql) en vez de por acción de un admin.
  cancelado_por          String?           @db.Uuid
  creado_en              DateTime          @default(now()) @db.Timestamptz
  actualizado_en         DateTime          @updatedAt @db.Timestamptz

  usuario           Perfiles           @relation("SuscripcionesDelUsuario", fields: [id_usuario], references: [id])
  plan              Planes?            @relation(fields: [id_plan], references: [id])
  cupon             Cupones?           @relation(fields: [id_cupon], references: [id])
  codigo_invitacion CodigosInvitacion? @relation(fields: [id_codigo_invitacion], references: [id])
  admin_otorgo      Perfiles?          @relation("SuscripcionesOtorgadasPorAdmin", fields: [otorgado_por], references: [id])
  admin_cancelo     Perfiles?          @relation("SuscripcionesCanceladasPorAdmin", fields: [cancelado_por], references: [id])
  pagos             Pagos[]

  @@index([id_usuario])
  @@index([id_plan])
  @@index([proveedor, id_suscripcion_externa])
  /// Los eventos `customer.*` de Stripe llegan identificados por el cliente,
  /// no por la suscripción: ese camino de conciliación necesita su índice.
  @@index([id_cliente_externo])
  @@index([id_cupon])
  @@index([id_codigo_invitacion])
  // Dos índices únicos PARCIALES viven como SQL crudo, no como @@unique
  // (Prisma no soporta WHERE en índices únicos nativos):
  //   - suscripcion_activa_unica_por_usuario (id_usuario) WHERE estado IN
  //     ('ACTIVA','PAST_DUE') -- 20260818142831_suscripcion_activa_unica_y_pgcrypto
  //   - suscripcion_codigo_unica_por_usuario (id_usuario, id_codigo_invitacion)
  //     WHERE id_codigo_invitacion IS NOT NULL --
  //     20260828130000_unico_codigo_por_usuario
  @@map("suscripciones")
}

/// Registro de un cobro. Tabla VACÍA: nada en el código escribe en ella
/// todavía, y llenarla es parte de la integración de cobro, que está diferida.
///
/// La idempotencia está pensada en dos niveles y los dos hacen falta:
///   - AQUÍ, por transacción: `@@unique([proveedor, ref_transaccion_externa])`
///     impide una segunda fila para el mismo cobro.
///   - En `EventosWebhook`, por evento: impide reprocesar la misma entrega.
/// Las dos claves se componen con `proveedor` porque dos pasarelas distintas
/// pueden emitir la misma cadena y nada más las distinguiría.
model Pagos {
  id                      String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_suscripcion          String     @db.Uuid
  /// Cuándo insertamos NOSOTROS la fila. No es la fecha del cobro: ver
  /// `fecha_pago`.
  creado_en               DateTime   @default(now()) @db.Timestamptz
  actualizado_en          DateTime   @updatedAt @db.Timestamptz
  /// Cuándo cobró la PASARELA, según la pasarela. Nullable porque no todas lo
  /// reportan; quien la lea cae a `creado_en`. Existe porque Stripe reintenta
  /// la entrega de un webhook hasta tres días, y sin esta columna el
  /// estudiante vería la fecha del reintento como la fecha de su pago.
  fecha_pago              DateTime?  @db.Timestamptz
  estado                  EstadoPago
  /// Qué pasarela procesó este cobro. Sin esta columna habría que deducirlo
  /// por join contra `suscripciones`, y la clave de idempotencia de abajo no
  /// se podría componer. Solo pasarelas reales: un acceso manual o por
  /// invitación nunca genera una fila aquí (CHECK en supabase/sql/042).
  proveedor               String
  /// BigInt por el techo de $21.474.836 COP de un INTEGER en centavos.
  monto_centavos          BigInt
  /// ISO-4217 en mayúsculas, garantizado por CHECK en supabase/sql/042.
  moneda                  String
  /// La CLAVE DE IDEMPOTENCIA: el identificador de la transacción del lado del
  /// proveedor. El nombre no lo transmite, por eso este comentario.
  ref_transaccion_externa String
  ref_factura_dian        String?
  url_pdf_factura         String?

  suscripcion Suscripciones @relation(fields: [id_suscripcion], references: [id])

  @@unique([proveedor, ref_transaccion_externa])
  @@index([id_suscripcion])
  @@map("pagos")
}

// ============================================================
// Módulo de Contenido (Catálogo LMS)
// ============================================================

model Categorias {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre           String
  /// Identificador legible para las URLs del catálogo. Lo genera la app
  /// desde `nombre` con slugificar() (src/lib/slug.ts); es único porque dos
  /// categorías no pueden compartir URL.
  slug             String   @unique
  descripcion      String?
  activo           Boolean  @default(true)
  id_admin_creador String?  @db.Uuid
  creado_en        DateTime @default(now()) @db.Timestamptz
  actualizado_en   DateTime @updatedAt @db.Timestamptz

  cursos        CursoCategorias[]
  admin_creador Perfiles?         @relation("CategoriasCreadasPorAdmin", fields: [id_admin_creador], references: [id])

  @@index([id_admin_creador])
  @@map("categorias")
}

/// Enlace temporal para previsualizar un curso en borrador sin tener cuenta
/// (Revcurso, requisito 3). Guarda el SHA-256 del token, nunca el token en
/// claro: un volcado de la base no debe entregar enlaces funcionales a
/// contenido sin publicar.
model TokensVistaPrevia {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token_hash       String    @unique
  id_curso         String    @db.Uuid
  id_admin_creador String?   @db.Uuid
  /// NOT NULL a propósito: no existe el enlace de vista previa permanente.
  expira_en        DateTime  @db.Timestamptz
  /// Corte manual antes de la caducidad, si el enlace se compartió por error.
  revocado_en      DateTime? @db.Timestamptz
  veces_usado      Int       @default(0)
  creado_en        DateTime  @default(now()) @db.Timestamptz
  actualizado_en   DateTime  @updatedAt @db.Timestamptz

  curso         Cursos    @relation(fields: [id_curso], references: [id], onDelete: Cascade)
  admin_creador Perfiles? @relation("TokensVistaPreviaCreadosPorAdmin", fields: [id_admin_creador], references: [id])

  @@index([id_curso])
  @@map("tokens_vista_previa")
}

/// Tabla puente curso↔categoría (muchos-a-muchos). Hoy el CMS solo asigna
/// una categoría por curso (no hay selector múltiple en el formulario),
/// pero el esquema ya soporta varias — ver auditoría de esquema (Bloque 3).
model CursoCategorias {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_curso       String   @db.Uuid
  id_categoria   String   @db.Uuid
  creado_en      DateTime @default(now()) @db.Timestamptz
  actualizado_en DateTime @updatedAt @db.Timestamptz

  curso     Cursos     @relation(fields: [id_curso], references: [id], onDelete: Cascade)
  categoria Categorias @relation(fields: [id_categoria], references: [id], onDelete: Restrict)

  @@unique([id_curso, id_categoria])
  @@index([id_categoria])
  @@map("curso_categorias")
}

/// Instructor del catálogo. NO es una cuenta: no existe en auth.users ni
/// inicia sesión — es información que el administrador gestiona desde el
/// panel para identificar quién dicta cada curso. `nombre` es único porque
/// el formulario de curso permite dar de alta uno nuevo sin salir, y sin
/// esa restricción se duplicarían.
model Instructores {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre           String   @unique
  especialidad     String?
  id_admin_creador String?  @db.Uuid
  creado_en        DateTime @default(now()) @db.Timestamptz
  actualizado_en   DateTime @updatedAt @db.Timestamptz

  admin_creador Perfiles? @relation("InstructoresCreadosPorAdmin", fields: [id_admin_creador], references: [id])
  cursos        Cursos[]

  @@map("instructores")
}

model Cursos {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titulo              String
  descripcion         String
  imagen_portada      String
  id_instructor       String     @db.Uuid
  nivel               NivelCurso @default(BASICO)
  destacado           Boolean    @default(false)
  orden_visualizacion Int        @default(0)
  mostrado            Boolean    @default(false)
  id_admin_creador    String     @db.Uuid
  creado_en           DateTime   @default(now()) @db.Timestamptz
  actualizado_en      DateTime   @updatedAt @db.Timestamptz

  instructor          Instructores        @relation(fields: [id_instructor], references: [id])
  admin_creador       Perfiles            @relation("CursosCreadosPorAdmin", fields: [id_admin_creador], references: [id])
  modulos             Modulos[]
  certificados        Certificados[]
  inscripciones       Inscripciones[]
  categorias          CursoCategorias[]
  tokens_vista_previa TokensVistaPrevia[]

  @@index([id_instructor])
  @@index([id_admin_creador])
  @@map("cursos")
}

model Modulos {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_curso       String   @db.Uuid
  titulo         String
  orden          Int      @default(0)
  creado_en      DateTime @default(now()) @db.Timestamptz
  actualizado_en DateTime @updatedAt @db.Timestamptz

  curso     Cursos      @relation(fields: [id_curso], references: [id], onDelete: Restrict)
  lecciones Lecciones[]

  @@index([id_curso])
  @@map("modulos")
}

model Lecciones {
  id                   String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_modulo            String                     @db.Uuid
  titulo               String
  orden                Int                        @default(0)
  /// Playback ID de Mux (docs/technical-spec.md §4) — se escribe recién en
  /// video.asset.ready. No se toca al reemplazar el video hasta que el
  /// nuevo asset esté listo (Flujo 10): el estudiante sigue viendo el
  /// anterior mientras el nuevo procesa.
  id_video_mux         String?
  /// ID del Direct Upload de Mux, guardado al pedirlo (antes de que exista
  /// el asset). Es la única forma de correlacionar el webhook de Mux
  /// (video.asset.ready/errored, video.upload.cancelled) con esta fila.
  id_mux_upload_id     String?                    @unique
  /// ID del asset de Mux una vez creado. Para operaciones futuras sobre el
  /// asset (no se usa para generar la URL firmada, que solo necesita el
  /// playback ID).
  id_mux_asset_id      String?
  duracion             Int?
  estado_procesamiento EstadoProcesamientoLeccion @default(SUBIENDO)
  /// Mensaje de Mux cuando estado_procesamiento = ERROR (video.asset.errored
  /// o video.upload.cancelled). Null en cualquier otro estado.
  error_procesamiento  String?
  resumen              String?
  creado_en            DateTime                   @default(now()) @db.Timestamptz
  actualizado_en       DateTime                   @updatedAt @db.Timestamptz

  modulo              Modulos                          @relation(fields: [id_modulo], references: [id], onDelete: Cascade)
  progreso            Progreso[]
  recursos            RecursosDescargables[]
  assetsMuxPendientes MuxAssetsPendientesEliminacion[]

  @@index([id_modulo, orden])
  @@map("lecciones")
}

/// Cola de assets de Mux pendientes de eliminar tras un reemplazo de video
/// (ver comentario en id_video_mux arriba: el asset viejo nunca se borra
/// antes de confirmar que el nuevo quedó listo). Se llena desde el webhook
/// (video.asset.ready) porque es el único punto que ve el id del asset
/// anterior antes de que el UPDATE de `lecciones` lo sobreescriba.
///
/// El borrado real contra la API de Mux (mux.video.assets.delete) todavía
/// no está implementado — depende de tener acceso al dominio de Mux del
/// equipo. `eliminado`/`eliminado_en` quedan listos para cuando exista ese
/// job de limpieza.
model MuxAssetsPendientesEliminacion {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_leccion   String?   @db.Uuid
  id_asset_mux String
  eliminado    Boolean   @default(false)
  eliminado_en DateTime? @db.Timestamptz
  creado_en    DateTime  @default(now()) @db.Timestamptz

  leccion Lecciones? @relation(fields: [id_leccion], references: [id], onDelete: SetNull)

  @@index([eliminado])
  @@map("mux_assets_pendientes_eliminacion")
}

// ============================================================
// Módulo de Operaciones y Seguimiento
// ============================================================

model Progreso {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_usuario     String   @db.Uuid
  id_leccion     String   @db.Uuid
  completado     Boolean  @default(false)
  segundo_actual Int      @default(0)
  creado_en      DateTime @default(now()) @db.Timestamptz
  actualizado_en DateTime @updatedAt @db.Timestamptz

  usuario Perfiles  @relation(fields: [id_usuario], references: [id])
  leccion Lecciones @relation(fields: [id_leccion], references: [id], onDelete: Cascade)

  @@unique([id_usuario, id_leccion])
  @@index([id_leccion])
  @@map("progreso")
}

model Certificados {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_usuario          String   @db.Uuid
  id_curso            String   @db.Uuid
  fecha_emision       DateTime @default(now()) @db.Timestamptz
  actualizado_en      DateTime @updatedAt @db.Timestamptz
  codigo_verificacion String   @unique
  archivo_pdf         String?

  usuario Perfiles @relation(fields: [id_usuario], references: [id])
  curso   Cursos   @relation(fields: [id_curso], references: [id])

  @@unique([id_usuario, id_curso])
  @@index([id_curso])
  @@map("certificados")
}

/// Código canjeable por acceso completo a la plataforma (equivalente a un
/// plan de cortesía), ver docs/functional-spec.md y auditoría de RLS. El
/// canje lo resuelve un Server Action con Service Role Key (mismo patrón
/// que Cupones en checkout): valida vigencia/límite de uso y crea la fila
/// de Suscripciones — nunca un INSERT directo del cliente contra esta
/// tabla ni contra Suscripciones.
/// Código que un estudiante canjea para obtener acceso, sin pasar por
/// ninguna pasarela de pago (MVP del 12 de septiembre de 2026).
///
/// NO apunta a un `Planes`: un código no vende un plan, regala un periodo
/// de acceso que el administrador fija libremente en `duracion_dias`. Antes
/// sí tenía `id_plan` y el canje sacaba de ahí la duración, lo que obligaba
/// al admin a traducir "quiero dar 45 días" a "elijo el plan que dure 45
/// días" — y a crear un plan falso cuando no existía ninguno con esa
/// duración.
model CodigosInvitacion {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo            String   @unique
  /// Días de acceso que otorga el canje, contados desde el momento de
  /// canjear. Lo usa public.canjear_codigo_invitacion() para calcular
  /// `suscripciones.fecha_renovacion`.
  duracion_dias     Int
  id_admin_creador  String?  @db.Uuid
  /// `@db.Timestamptz` por el mismo motivo que las fechas de `Suscripciones`:
  /// las vistas de métricas y el canje la comparan contra `now()`, y sin zona
  /// esa comparación dependía de la TimeZone de la sesión.
  fecha_vencimiento DateTime @db.Timestamptz
  /// Cuántas veces se puede canjear. Obligatorio y con CHECK >= 1 en la
  /// base (`codigos_invitacion_limite_usos_positivo`, ver la migración
  /// 20260827000000): la regla de negocio es "uso único o con límite,
  /// nunca ilimitado", y dejarlo nullable permitía crear por descuido un
  /// código que cualquiera puede repartir sin tope.
  limite_usos       Int
  veces_usado       Int      @default(0)
  activo            Boolean  @default(true)
  creado_en         DateTime @default(now()) @db.Timestamptz
  actualizado_en    DateTime @updatedAt @db.Timestamptz

  admin_creador Perfiles?       @relation("CodigosInvitacionCreadosPorAdmin", fields: [id_admin_creador], references: [id])
  suscripciones Suscripciones[]

  @@map("codigos_invitacion")
}

/// Descuento aplicable en el checkout — entidad DISTINTA de
/// `CodigosInvitacion`, que regala acceso sin pasar por caja. Sin uso en el
/// código todavía: existe para cuando llegue el cobro.
model Cupones {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo            String        @unique
  tipo_descuento    TipoDescuento
  /// OJO — la unidad depende de `tipo_descuento`: centavos cuando es
  /// MONTO_FIJO, y un porcentaje entero (0-100) cuando es PORCENTAJE. Una sola
  /// columna para dos unidades; quien la lea tiene que ramificar. BigInt por
  /// la mitad de los casos que sí son dinero.
  valor             BigInt
  fecha_vencimiento DateTime      @db.Timestamptz
  limite_usos       Int?
  veces_usado       Int           @default(0)
  creado_en         DateTime      @default(now()) @db.Timestamptz
  actualizado_en    DateTime      @updatedAt @db.Timestamptz

  suscripciones Suscripciones[]

  @@map("cupones")
}

model Inscripciones {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_usuario        String     @db.Uuid
  id_curso          String     @db.Uuid
  otorgado_por      String?    @db.Uuid
  tipo_acceso       TipoAcceso
  /// Revocar (f4accesos.md) no borra la fila — la marca inactiva. Sigue
  /// siendo la única forma de reconciliar el índice único
  /// (id_usuario, id_curso): un re-otorgamiento después de revocar
  /// reactiva esta misma fila en vez de intentar insertar una segunda
  /// (ver ofrecerCortesia, src/actions/admin/usuarios.ts).
  activo            Boolean    @default(true)
  revocado_en       DateTime?  @db.Timestamptz
  motivo_revocacion String?
  revocado_por      String?    @db.Uuid
  creado_en         DateTime   @default(now()) @db.Timestamptz
  actualizado_en    DateTime   @updatedAt @db.Timestamptz

  usuario      Perfiles  @relation("InscripcionesDelUsuario", fields: [id_usuario], references: [id])
  curso        Cursos    @relation(fields: [id_curso], references: [id])
  admin_otorgo Perfiles? @relation("InscripcionesOtorgadasPorAdmin", fields: [otorgado_por], references: [id])
  admin_revoco Perfiles? @relation("InscripcionesRevocadasPorAdmin", fields: [revocado_por], references: [id])

  @@unique([id_usuario, id_curso])
  @@index([id_curso])
  @@map("inscripciones")
}

model BitacoraAdministrativa {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_admin            String   @db.Uuid
  accion              String
  id_entidad_afectada String?  @db.Uuid
  entidad_afectada    String
  /// Log de solo-lectura (append-only): a propósito no tiene
  /// actualizado_en, ver docs/technical-spec.md — una fila de bitácora
  /// nunca se edita después de creada.
  creado_en           DateTime @default(now()) @db.Timestamptz
  detalles            String?

  admin Perfiles @relation(fields: [id_admin], references: [id])

  @@index([id_admin])
  @@map("bitacora_administrativa")
}

/// Bitácora de idempotencia de TODO webhook entrante (CLAUDE.md §3.1: se
/// registra aquí antes de ejecutar cualquier lógica de negocio). No es solo de
/// pagos: `proveedor` incluye 'mux', que no cobra nada — por eso el CHECK de
/// esta tabla admite un conjunto distinto al de `pagos`.
///
/// RLS activo SIN política (supabase/sql/003): nadie la lee ni la escribe
/// salvo el backend con Service Role Key.
model EventosWebhook {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proveedor         String
  /// Identificador del evento del lado del proveedor: `evt_...` en Stripe, un
  /// UUID en Mux, y en Wompi el checksum SHA-256 del propio evento (no manda
  /// id, ver el comentario en app/api/webhooks/wompi/route.ts).
  id_evento_externo String
  tipo_evento       String
  payload           Json
  procesado         Boolean  @default(false)
  creado_en         DateTime @default(now()) @db.Timestamptz
  actualizado_en    DateTime @updatedAt @db.Timestamptz

  @@unique([proveedor, id_evento_externo])
  @@map("eventos_webhook")
}

model RecursosDescargables {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_leccion     String   @db.Uuid
  nombre         String
  tipo_archivo   String
  url_archivo    String
  tamano_bytes   Int?
  creado_en      DateTime @default(now()) @db.Timestamptz
  actualizado_en DateTime @updatedAt @db.Timestamptz

  leccion Lecciones @relation(fields: [id_leccion], references: [id])

  @@index([id_leccion])
  @@map("recursos_descargables")
}
